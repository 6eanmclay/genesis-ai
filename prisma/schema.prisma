// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  password      String?
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts              Account[]
  sessions              Session[]
  stores                Store[]
  draft                 StoreDraft?
  storeMemberships      StoreMember[]
  connectedIntegrations StoreIntegration[]
  executionLogs         ExecutionLog[]
  productEvents         ProductEvent[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Store {
  id            String   @id @default(cuid())
  userId        String
  name          String
  slug          String   @unique
  description   String?
  tagline       String?
  logoUrl       String?
  theme         Json?
  blueprint     Json?
  pendingChange Json?
  published     Boolean  @default(false)
  version       Int      @default(1)
  // Phase 3 Milestone 2 — code-level taxonomy slugs (lib/businessTaxonomy.ts),
  // never a Prisma enum: a String[] so a new category/subcategory is a
  // purely additive code change, matching ApprovalRequest.status's own
  // "avoid enum-migration friction" convention. Drives Recommended
  // Connections. Classified once at generation time (see ai-actions.ts's
  // CoreFieldsSchema); a real backfill for pre-existing stores is a later,
  // smaller addition.
  businessCategories String[] @default([])
  // Phase 3 Milestone 5 — same shape/reasoning as businessCategories above,
  // a second, independent classification axis: *how* the business makes
  // money (product_sales/service_fees/subscriptions/...), not *what
  // industry* it's in. See lib/businessTaxonomy.ts's REVENUE_STREAM_TYPES.
  revenueStreams String[] @default([])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user                     User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  products                 Product[]
  visions                  StoreGeneration[]
  orders                   Order[]
  messages                 StoreMessage[]
  subscribers              NewsletterSignup[]
  members                  StoreMember[]
  integrations             StoreIntegration[]
  executionLogs            ExecutionLog[]
  generatedRecommendations GeneratedRecommendation[]
  approvalRequests         ApprovalRequest[]
  observations             GenesisObservation[]
  postExecutionMeasurements PostExecutionMeasurement[]
  delegatedAuthorities      DelegatedAuthority[]
  productEvents             ProductEvent[]
  businessRecords           BusinessRecord[]
  businessEvents            BusinessEvent[]
  cognitiveOutputs          CognitiveOutput[]
  beliefs                   Belief[]
}

// The owner is still just Store.userId (unchanged) — this table is only for
// non-owner access (Employee today, more roles later) so existing
// single-owner flows and data are untouched. See lib/permissions.ts.
enum StoreRole {
  OWNER
  EMPLOYEE
}

model StoreMember {
  id        String    @id @default(cuid())
  storeId   String
  userId    String
  role      StoreRole
  createdAt DateTime  @default(now())

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([storeId, userId])
}

// Providers named across the roadmap (Stripe, PayPal) plus the ones raised
// as future examples (Google, Slack, USPS) — extending this later is a
// one-line enum addition, not a schema redesign. See lib/integrations/.
//
// Phase 3 Milestone 2 (Connector Framework) — GOOGLE_CALENDAR/QUICKBOOKS/
// MAILCHIMP added as the 3 proof integrations. GOOGLE itself is left
// reserved-but-unused rather than repurposed for Calendar specifically:
// @@unique([storeId, provider]) on StoreIntegration means each distinct
// integration *surface* needs its own identity, since a business could
// plausibly connect Calendar and (later) Gmail/Drive independently — a
// single shared "Google" value would make status ambiguous once a second
// Google surface exists.
enum IntegrationProvider {
  STRIPE
  PAYPAL
  GOOGLE
  SLACK
  USPS
  GOOGLE_CALENDAR
  QUICKBOOKS
  MAILCHIMP
}

enum IntegrationStatus {
  CONNECTED
  NEEDS_ATTENTION
  FAILED
  DISCONNECTED
}

// One generic table for every provider — provider-specific detail lives in
// the opaque `credentials` Json, not as new columns per integration. Same
// shape philosophy as StoreMember.
model StoreIntegration {
  id                String              @id @default(cuid())
  storeId           String
  provider          IntegrationProvider
  status            IntegrationStatus   @default(DISCONNECTED)
  externalAccountId String?
  credentials       Json?
  connectedByUserId String?
  connectedAt       DateTime?
  lastVerifiedAt    DateTime?
  lastError         String?
  // Phase 3 Milestone 3 (Business Intelligence Engine) — sync *scheduling*
  // state, deliberately separate from status/lastVerifiedAt/lastError above
  // (connection *health* — is the credential valid — a different concern
  // from sync *cadence*). nextSyncDueAt is what makes the scheduler
  // trigger-frequency-agnostic: computed once per attempt, independent of
  // how often the cron route itself gets invoked — see lib/intelligence/
  // scheduler.ts. Full sync attempt history lives in ExecutionLog
  // (already written by syncExecutable), not duplicated here.
  lastSyncedAt      DateTime?
  nextSyncDueAt     DateTime?
  syncFailureCount  Int                 @default(0)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  store       Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
  connectedBy User? @relation(fields: [connectedByUserId], references: [id], onDelete: SetNull)

  @@unique([storeId, provider])
  @@index([status, nextSyncDueAt])
}

model StoreDraft {
  id               String   @id @default(cuid())
  userId           String   @unique
  inputStoreName   String?
  inputProductType String?
  inputVision      String?
  name             String
  description      String?
  tagline          String?
  theme            Json?
  productsDraft    Json?
  blueprint        Json?
  pendingChange    Json?
  status           String   @default("draft")
  version          Int      @default(1)
  // Phase 3 Milestone 2 — see Store.businessCategories's own comment; this
  // is the draft-stage copy, carried over to Store at confirmStoreDraft.
  businessCategories String[] @default([])
  // Phase 3 Milestone 5 — see Store.revenueStreams's own comment; same
  // draft-stage-copy pattern as businessCategories above.
  revenueStreams String[] @default([])
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user          User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  generations   StoreGeneration[]
  messages      StoreDraftMessage[]
  executionLogs ExecutionLog[]
}

model StoreDraftMessage {
  id           String   @id @default(cuid())
  storeDraftId String
  role         String
  content      String
  changes      Json?
  createdAt    DateTime @default(now())

  storeDraft StoreDraft @relation(fields: [storeDraftId], references: [id], onDelete: Cascade)
}

model StoreMessage {
  id        String   @id @default(cuid())
  storeId   String
  role      String
  content   String
  changes   Json?
  createdAt DateTime @default(now())

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
}

model StoreGeneration {
  id              String   @id @default(cuid())
  storeDraftId    String?
  storeId         String?
  version         Int
  promptVersion   String   @default("v1")
  milestone       String?
  generatedOutput Json
  createdAt       DateTime @default(now())

  storeDraft StoreDraft? @relation(fields: [storeDraftId], references: [id], onDelete: Cascade)
  store      Store?      @relation(fields: [storeId], references: [id], onDelete: Cascade)
}

model Product {
  id           String   @id @default(cuid())
  storeId      String
  name         String
  description  String?
  richContent  Json?
  priceInCents Int
  imageUrl     String?
  active       Boolean  @default(true)
  position     Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  store  Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  orders Order[]
}

model NewsletterSignup {
  id        String   @id @default(cuid())
  storeId   String
  email     String
  createdAt DateTime @default(now())

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, email])
}

// paymentProvider/externalOrderId are provider-agnostic (PH-06) — replaced
// the Stripe-specific stripeSessionId column so a PayPal order (or any
// future provider's) has an equally first-class identity, not a shoehorned
// one. Composite-unique rather than a bare unique on externalOrderId, so
// two providers' ids can never collide.
model Order {
  id              String              @id @default(cuid())
  storeId         String
  productId       String?
  productName     String
  amountInCents   Int
  buyerEmail      String
  status          String              @default("paid")
  paymentProvider IntegrationProvider
  externalOrderId String
  createdAt       DateTime            @default(now())

  store   Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@unique([paymentProvider, externalOrderId])
}

// The Execution & Verification Engine's history: append-only, never updated.
// A logical request's status changing over time (e.g. an OAuth handoff going
// PENDING -> SUCCESS) is a new row sharing `executionId`, not a mutated row —
// see ARCHITECTURE.md. `action` is a plain String (not an enum) because the
// action catalog grows with every feature, unlike IntegrationProvider which
// only grows when a human deliberately writes a new connector.
//
// storeId/storeDraftId are both optional, same dual-phase pattern as
// StoreGeneration: most executions belong to a real Store, but Genesis's
// draft-side chat happens before a Store exists at all, only a StoreDraft.
model ExecutionLog {
  id            String   @id @default(cuid())
  executionId   String
  storeId       String?
  storeDraftId  String?
  action        String
  status        String // SUCCESS | WARNING | FAILED | PENDING
  verified      Boolean  @default(false)
  message       String
  retryable     Boolean  @default(false)
  actorType     String // USER | GENESIS | SYSTEM
  actorId       String?
  schemaVersion Int      @default(1)
  metadata      Json?
  createdAt     DateTime @default(now())

  store      Store?      @relation(fields: [storeId], references: [id], onDelete: Cascade)
  storeDraft StoreDraft? @relation(fields: [storeDraftId], references: [id], onDelete: Cascade)
  actor      User?       @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([storeId, createdAt])
  @@index([storeId, action])
  @@index([executionId])
}

// PH-07 Layer 3 — Genesis-generated recommendations, cached so the dashboard
// never makes an AI call during a normal page render (only an explicit
// "Refresh Genesis Suggestions" click does). No `source` column: every row
// here is by definition source: "genesis" once mapped to the shared
// Recommendation type — see lib/dashboard/recommendations.ts.
// Phase 3 Milestone 6 (J4 Cognitive Layer) — superseded as a write target.
// lib/intelligence/cognitiveLayer.ts's runCognitiveReview() (formerly
// generateGenesisRecommendations()) now writes CognitiveOutput rows
// instead. Left in place, unwritten-to going forward, rather than deleted
// or migrated — matching this codebase's "don't rewrite history" discipline
// (ExecutionLog is append-only for the same reason). Historical rows and
// this model's own shape stay exactly as they were; retiring it fully is
// separate, explicit future cleanup, not forced here.
model GeneratedRecommendation {
  id          String   @id @default(cuid())
  storeId     String
  priority    String // high | medium | low
  message     String
  actionLabel String
  actionHref  String
  generatedAt DateTime @default(now())
  // Phase 3 Milestone 5 — same shape/nullability as BusinessEvent.recordId
  // above: which specific BusinessRecord (a Goal, a Challenge, a Contact,
  // ...) this recommendation is actually about, when it's about one
  // specific entity rather than the business in aggregate. Null is the
  // honest, common case — most recommendations (today: theme/hero/SEO
  // copy) aren't about any one record. ApprovalRequest deliberately does
  // NOT duplicate this column — it already links back here via
  // recommendationId, so recordId is read by joining through, matching how
  // topicKey's own "underlying issue identity" is likewise only ever set
  // here, not copied onto every table that references a recommendation.
  recordId    String?
  entityType  String?

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId])
}

// Phase 3 Milestone 6 (J4 Cognitive Layer) — the durable, queryable record
// of everything Genesis has reasoned about the business, polymorphic across
// every real output kind (same "one generic table, JSON payload, code-level
// discrimination" convention as BusinessRecord/GenesisObservation/
// ExecutionLog/ProductEvent — never a table per kind). Produced by the
// Observe -> Explain -> Recommend stages of runCognitiveReview();
// approvalRequestId is set once the Execute stage (unchanged — the existing
// GENESIS_ACTIONS/execute()/DelegatedAuthority machinery) acts on one.
//
// relatedOutputIds is a second, deliberately SEPARATE reference space from
// BusinessRecord's own xxxId/xxxIds convention: recordId points into "what's
// true about the business" (a Goal, a Challenge, a Contact...);
// relatedOutputIds points into "what Genesis has reasoned about it" (a
// Recommendation citing the Opportunity it addresses, an Opportunity citing
// the Explanation it's grounded in). Not merged into findRelated(), which
// only ever walks BusinessRecord space — these are two distinct graphs.
model CognitiveOutput {
  id          String    @id @default(cuid())
  storeId     String
  kind        String    // insight | prediction | explanation | recommendation | opportunity
  summary     String    // self-contained — matches every existing "message must be self-contained" convention
  data        Json?     // structured supporting detail specific to kind (e.g. an insight's own real metrics)
  priority    String?   // high | medium | low — recommendation/opportunity/prediction; null for insight/explanation
  // Real columns, not buried in `data` — matches GeneratedRecommendation's
  // own precedent, since these are directly queried/displayed (Home's
  // "From Genesis" panel), not just supporting detail. Null for kinds that
  // never carry a direct action (insight, explanation).
  actionLabel String?
  actionHref  String?
  recordId    String?   // which BusinessRecord this is about, if any — same honest-null convention as BusinessEvent.recordId
  entityType  String?
  relatedOutputIds String[] @default([])
  // Same stable-issue-identity concept as ApprovalRequest.topicKey, used the
  // same way: dedup/supersede across review runs for the same underlying
  // finding, honest null when no such stable identity exists.
  topicKey    String?
  proposedAction   Json?   // {actionType, input} — same shape as ProposedActionSchema
  approvalRequestId String?
  status      String    @default("ACTIVE") // ACTIVE | RESOLVED | SUPERSEDED
  generatedAt DateTime  @default(now())
  resolvedAt  DateTime?

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId, kind])
  @@index([storeId, status])
  @@index([storeId, recordId])
}

// PH-07 Layer 4 — the generic approval gate any current or future Genesis
// capability plugs into. Deliberately not recommendation-specific:
// recommendationId is a loose, optional reference (no FK — see
// ARCHITECTURE.md for why), never a required one. Only three statuses:
// approving and executing collapse into one EXECUTED state since the
// approve flow is synchronous (execute() never throws past its own
// boundary) — the actual outcome quality (SUCCESS/WARNING/PARTIAL/FAILED)
// lives on the linked ExecutionLog row via executionId, not duplicated
// here. No ExecutionLog row is written at proposal or rejection time —
// ExecutionLog represents things that were actually executed.
model ApprovalRequest {
  id               String    @id @default(cuid())
  storeId          String
  recommendationId String?
  // Phase 3 Milestone 6 (J4 Cognitive Layer) — parallel to
  // recommendationId above, not a replacement: set when this approval
  // originates from the Cognitive Layer's own CognitiveOutput rows instead
  // of the legacy GeneratedRecommendation model. Both stay nullable and
  // independently optional — an approval only ever has at most one set.
  cognitiveOutputId String?
  actionType       String
  input            Json
  previousValues   Json
  summary          String
  status           String    @default("PENDING_APPROVAL") // PENDING_APPROVAL | EXECUTED | REJECTED
  authorizationTier String   @default("always_ask") // always_ask | auto_below_limit | auto — frozen snapshot of the tier that governed this request at creation time, see lib/execution/genesisActions.ts
  groupId          String?   // shared across every ApprovalRequest created from one Genesis "thought" (one chat turn, or one recommendation-review run) — Phase 4 — presentational grouping only; never merges the underlying decision or execution
  // Phase 5 — stable identity of the underlying BUSINESS ISSUE/OPPORTUNITY
  // this action addresses (same concept as GenesisObservation.dedupeKey for
  // AI-detected opportunities) — deliberately NOT an identity of this one
  // recommendation/action instance. Populated only when the proposing
  // Claude call can name a real, stable underlying issue (today: only
  // generateGenesisRecommendations.ts's review path); left null rather than
  // a fabricated/generic slug when no such identity genuinely exists (e.g.
  // most chat-driven, owner-directed requests like "make my website blue"
  // — see the Phase 5 plan for why that's an honest null, not a gap).
  topicKey         String?
  // Phase 6 — frozen snapshot of HOW this request was decided, never
  // recomputed. "human" = a real owner/employee click (approveGenesisAction/
  // rejectGenesisAction/revertApprovalRequest). "autonomous" = Genesis
  // itself decided, under a specific granted DelegatedAuthority row
  // (delegatedAuthorityId below) — never the model's own judgment about
  // whether it's allowed, only a deterministic grant lookup performed in
  // code before execution. See lib/execution/genesisAutonomy.ts.
  decisionMode        String  @default("human") // human | autonomous
  // The specific grant that authorized an autonomous decision, snapshotted
  // at decision time so "why was Genesis allowed to do this" is answerable
  // forever, even after the grant is later revoked. Null for "human" rows.
  // Loose reference (no FK), same convention as recommendationId.
  delegatedAuthorityId String?
  executionId      String?
  decidedByUserId  String?
  decidedAt        DateTime?
  createdAt        DateTime  @default(now())

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
  postExecutionMeasurement PostExecutionMeasurement?

  @@index([storeId, status])
}

// Phase 6 — the smallest durable representation of "the owner has authorized
// Genesis to handle this kind of decision for their business," without a
// generic policy engine. Scoped per (store, actionType) deliberately, not
// per category — a category grouping is presentation-only (see
// GENESIS_ACTIONS' category field); each action type earns trust
// individually, and a brand-new action type never silently inherits an
// existing category's grant. Revocation is immediate: every check reads
// `revokedAt IS NULL` live, at the moment of decision — no caching, no
// propagation delay, no in-flight action to interrupt (today's Executables
// are single synchronous writes).
model DelegatedAuthority {
  id              String    @id @default(cuid())
  storeId         String
  actionType      String
  grantedAt       DateTime  @default(now())
  // Always an OWNER — grantDelegatedAuthority requires
  // PERMISSIONS.AUTHORITY_MANAGE, which only OWNER holds (see
  // lib/permissions.ts). An employee cannot create, benefit from, or
  // influence a grant.
  grantedByUserId String
  revokedAt       DateTime?

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, actionType])
}

// Phase 5 — "what we observed in the business after this execution," never
// "the impact this execution had." One row per measured EXECUTED
// ApprovalRequest, computed once (deterministically, zero AI cost) when its
// fixed measurement window has elapsed, never re-evaluated. There is
// deliberately no field anywhere here for a percentage, a "lift," a
// direction label, or any other verdict — only two raw before/after counts,
// a template-generated sentence built from them, and concurrentActionTypes
// (which other Genesis actions ALSO executed inside the same before/after
// window). concurrentActionTypes exists purely to flag how confounded a
// given window is; it is never used to net out or weight anyone's
// contribution — this system does not and should not calculate attribution.
model PostExecutionMeasurement {
  id                 String   @id @default(cuid())
  approvalRequestId  String   @unique
  storeId            String
  actionType         String   // denormalized from ApprovalRequest — cheap grouping without a join
  topicKey           String?  // denormalized from ApprovalRequest at measurement time — see topicKey's own comment above
  scope              String   // "store" | "product"
  productId          String?  // set only when scope is "product" (today: only update_product_image)
  windowDays         Int      // fixed constant (see lib/dashboard/postExecutionMeasurement.ts), not owner-configurable
  orderCountBefore   Int
  orderCountAfter    Int
  revenueBeforeCents Int?
  revenueAfterCents  Int?
  concurrentActionTypes String[] // other Genesis actionTypes EXECUTED for this store inside the same before/after window
  summary            String   // deterministic, template-generated — the confounding caveat is baked into the sentence itself whenever concurrentActionTypes is non-empty, never a separate field someone could quote without it
  measuredAt         DateTime @default(now())

  store           Store           @relation(fields: [storeId], references: [id], onDelete: Cascade)
  approvalRequest ApprovalRequest @relation(fields: [approvalRequestId], references: [id], onDelete: Cascade)

  @@index([storeId, measuredAt])
}

// Phase 4 — the durable distinction between "Genesis noticed this" and a
// recommendation being recomputed every render. Keyed by a stable dedupeKey
// (a hand-written state-issue id, a real ExecutionLog/StoreIntegration row
// id, or an AI-authored topicKey) so re-detecting the same real condition
// upserts the existing row instead of spawning a duplicate or re-notifying.
// genesisState is deliberately narrow — only "opportunity" (Purple) and
// "urgent" (Red) ever get persisted here; Yellow already has real backing
// via pending ApprovalRequests and White/Blue need no persisted state at
// all. Routine incomplete-setup state (unpublished/no products/no payment)
// is never written here — that stays Business Journey's job, positively
// framed, never duplicated as an alarming Red signal.
model GenesisObservation {
  id              String    @id @default(cuid())
  storeId         String
  dedupeKey       String
  genesisState    String // opportunity | urgent
  summary         String
  actionHref      String?
  status          String    @default("ACTIVE") // ACTIVE | RESOLVED | DISMISSED
  firstNoticedAt  DateTime  @default(now())
  lastConfirmedAt DateTime  @default(now())
  resolvedAt      DateTime?
  dismissedAt     DateTime?
  // Phase 3 Milestone 5 — same shape/nullability/reasoning as
  // GeneratedRecommendation.recordId above: which specific BusinessRecord
  // this observation is about, when there is one (e.g. a specific
  // high-severity Challenge) — null for genuinely store-wide observations
  // (e.g. "no payment connected"), same honest-null convention.
  recordId        String?
  entityType      String?

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, dedupeKey])
  @@index([storeId, status])
}

// Family-beta behavioral/friction instrumentation (v20). One generic,
// append-only event table — deliberately not several bespoke tables — for
// everything the existing audit/business models (ExecutionLog, StoreMessage,
// ApprovalRequest, GenesisObservation) don't already capture: navigation,
// focus-routing outcomes, chat turn latency, perceived-loading duration, and
// the pre-launch creation ("Welcome to Genesis") journey. `name` is a plain,
// freely-growing String catalog (see EXECUTION_ACTIONS's own reasoning),
// never an enum. `attemptKey` is the correlation seam for reconstructing an
// attempt sequence (entered -> problem -> attempt 1 -> attempt 2 -> recovered
// or abandoned) — always a real, already-meaningful identity already used
// elsewhere (topicKey, groupId, dedupeKey, a storeDraftId, a fixed flow name)
// rather than an invented counter. `metadata` only ever holds small,
// allow-listed structured fields and *references* to other rows' own ids —
// never raw chat/form content, which stays in its own real row and is joined
// at reconstruction time.
model ProductEvent {
  id                String    @id @default(cuid())
  userId            String?
  storeId           String?
  // Deliberately NOT a real relation (unlike storeId/userId below) — a
  // StoreDraft is deleted as the normal, successful terminal step of the
  // creation journey (confirmStoreDraft), not an edge case, and the
  // "creation.confirmed" event is written *after* that delete. A hard FK
  // here would either cascade-delete the very creation.* history this
  // table exists to preserve, or reject the terminal event's own insert —
  // same "no FK, might legitimately outlive its referent" reasoning
  // ApprovalRequest.recommendationId already uses.
  storeDraftId      String?
  sessionInstanceId String
  name              String
  category          String // navigation | chat | approval | integration | creation | performance | journey
  attemptKey        String?
  outcome           String? // success | failure | abandoned | null (in progress / not applicable)
  durationMs        Int?
  metadata          Json?
  createdAt         DateTime  @default(now())

  user  User?  @relation(fields: [userId], references: [id], onDelete: Cascade)
  store Store? @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([sessionInstanceId, createdAt])
  @@index([attemptKey])
  @@index([storeId, createdAt])
}

// Phase 3 Milestone 1 (J4 Foundation) — J4's canonical, provider-agnostic
// understanding of "a business." One generic table for every entity type
// (contact/transaction/item/appointment/campaign/... — see
// lib/businessModel/entities.ts's registry), same shape philosophy as
// StoreIntegration/GenesisObservation/ProductEvent: entityType and
// sourceProvider are plain Strings, not enums, so a new entity type or a new
// connector never needs a migration. `data`'s shape is validated against
// entities.ts's Zod schema for entityType at write time, not enforced here.
// Cross-entity relationships are NOT a separate join table — any field in
// `data` named `xxxId`/`xxxIds` is a reference to another BusinessRecord.id
// by convention; see lib/businessModel/reasoning.ts's findRelated for why
// this is enough to make relationship traversal generic across every
// entity type, including ones added later.
//
// sourceProvider "internal" (the live store's own Order/Product data) is
// reserved but never actually written here — lib/businessModel/
// internalMapper.ts computes those records live on every read instead of
// persisting a synced copy, since that data is already live in Postgres.
// This table is created now so a real external connector (Phase 3
// Milestone 2) needs zero schema change of its own, only population.
model BusinessRecord {
  id             String   @id @default(cuid())
  storeId        String
  entityType     String
  sourceProvider String
  externalId     String
  data           Json
  syncedAt       DateTime @default(now())

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, entityType, sourceProvider, externalId])
  @@index([storeId, entityType])
}

// Phase 3 Milestone 3 (Business Intelligence Engine) — the standardized,
// provider-independent event Change Detection produces (lib/intelligence/
// changeDetection.ts) whenever a BusinessRecord meaningfully changes, or a
// time-based condition becomes true (e.g. an invoice crossing its due
// date with no new sync data at all). Deliberately carries no
// severity/importance of its own — that judgment belongs to the Insight
// Engine downstream (lib/intelligence/insights.ts); this table only ever
// records facts. Append-only, no dedup at this layer — dedup/auto-resolve
// already exists one layer further down, on GenesisObservation.
model BusinessEvent {
  id             String    @id @default(cuid())
  storeId        String
  entityType     String
  eventType      String // "contact.created" | "invoice.paid" | "invoice.overdue" | "appointment.cancelled" | ...
  recordId       String? // the BusinessRecord.id this is about — null for store-level aggregate events
  sourceProvider String
  summary        String
  data           Json?
  occurredAt     DateTime  @default(now())
  processedAt    DateTime? // set once the Insight Engine has considered it — null means new/unprocessed

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId, occurredAt])
  @@index([storeId, processedAt])
}

// J4 Foundation Phase 2 — the Learn cognitive subsystem's durable store.
// Deliberately distinct in kind from every other model in this file:
// BusinessRecord/BusinessEvent/CognitiveOutput all hold verified,
// first-order fact or Reason's own point-in-time conclusions; a Belief
// holds an INFERRED, REVISABLE generalization drawn from many of those over
// time, and must never be merged into or confused with either — see the
// Learn subsystem specification (memory: project_j4_cognitive_architecture.md)
// for the full "fact vs. belief" epistemic boundary this table exists to
// keep honest.
//
// No stored "maturity stage" (Observation/Hypothesis/Established Belief/...)
// — deliberately. Maturity is a DERIVED read computed from evidenceCount/
// firstObservedAt/lastContradictedAt/confidence at the moment something
// needs a human-readable label, never an independently authored or
// transitioned piece of state — this keeps the schema honest, with nothing
// here representing a category boundary someone had to judge.
model Belief {
  id       String @id @default(cuid())
  storeId  String
  // Same stable-identity concept ApprovalRequest.topicKey/CognitiveOutput.
  // topicKey already use — the underlying pattern this belief is about,
  // independent of exact wording, so new evidence updates the SAME belief
  // instead of spawning a duplicate every time it's re-confirmed.
  topicKey String
  claim    String // a real, self-contained sentence Reason can use directly
  category String // open vocabulary: "insight_recurrence" | "outcome_pattern" | "owner_preference" | ...

  confidence Float // 0-1 — current strength of evidential support, see computeConfidence in lib/intelligence/learn.ts
  evidenceCount Int // breadth — how many independent instances support this, distinct from confidence on purpose

  firstObservedAt    DateTime // when the earliest contributing evidence occurred, not when this row was created
  lastConfirmedAt    DateTime // most recent evidence that supported (or didn't contradict) this belief
  lastContradictedAt DateTime? // most recent evidence that went AGAINST it — comparing this to lastConfirmedAt is what detects Reconsideration (a long-stable belief suddenly facing contradiction)

  // Real, inspectable grounding — ExecutionLog/CognitiveOutput/BusinessEvent/
  // PostExecutionMeasurement ids that contributed, plus the actual computed
  // numbers behind the claim. A belief with nothing here is not allowed to
  // exist, per Learn's own traceability invariant.
  evidenceRefs String[] @default([])
  data         Json?

  recordId   String? // same honest-null convention as CognitiveOutput/BusinessEvent — set only when genuinely about one specific record
  entityType String?

  status        String    @default("ACTIVE") // ACTIVE | RETIRED
  retiredAt     DateTime?
  retiredReason String? // plain text, not a rigid enum — "absorbed into a more general belief" | "did not generalize" | "contradicted by new evidence"

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, topicKey])
  @@index([storeId, status])
}
