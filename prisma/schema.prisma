// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                String         @id @default(cuid())
  email             String         @unique
  name              String?
  password          String?
  emailVerified     DateTime?
  image             String?
  // Growth Points Economy (Chapter 2) — the user's own durable, shareable
  // referral code. Generated lazily on first access (most users never share
  // one), not at signup — see lib/growthPoints/referral.ts. Deliberately a
  // separate field from Referral.code: this is a stable per-user identity
  // that can be shared before any referral exists; Referral.code is a
  // per-relationship snapshot of which code was used for one specific
  // referred signup, written once redeemed.
  referralCode      String?        @unique
  // WHICH BUSINESS IS THIS PERSON WORKING IN (2026-08-20).
  //
  // A Genesis account holds several businesses, each with its own identity,
  // catalogue, connections, points, plan and J4 understanding. Before this
  // column there was no answer to "which one" — resolveUserStore picked the most
  // recently UPDATED store, and 47 call sites relied on it. A second business
  // would have become the active one the moment anything touched it: edit a
  // product in it and orders, connections and billing follow.
  //
  // Set only by a deliberate act — creating a business, or switching to one (see
  // lib/businessContext.ts's setActiveBusiness, the single writer). Never as a
  // side effect of updating a store, which is the whole difference between an
  // explicit context and a recency heuristic wearing one's clothes.
  //
  // Nullable: a brand-new account has no business yet. SetNull rather than
  // Cascade, because deleting a business must leave the account working rather
  // than orphaning the person who owned it.
  activeStoreId     String?
  activeStore       Store?         @relation("ActiveBusiness", fields: [activeStoreId], references: [id], onDelete: SetNull)
  // Sessions are JWTs, so there is no server-side session row to delete when
  // someone resets their password — a token already in an attacker's hands
  // stays valid until it expires on its own. That makes "someone got into my
  // account, I'll change my password" not actually evict them, which is the
  // single thing that flow exists to do. Every JWT carries an `iat`; any token
  // issued before this timestamp is refused. Null for accounts that have never
  // reset, which is the same as "no reason to refuse anything".
  passwordChangedAt DateTime?
  /// "Don't ask me about Growth Points again" — when they said it, and at what
  /// cost. GLOBAL, not per-feature: Sean's rule covers "every Growth Point-
  /// consuming action, not something implemented separately for Creation
  /// Station, Social, or individual features."
  ///
  /// The cost is kept beside the timestamp because the preference has a stated
  /// limit — "Always override the preference if the cost materially changes" —
  /// and a 1-point action somebody waved through does not authorise a 10-point
  /// one. Null means they have never opted out, which is true of every account
  /// that predates this.
  growthPointConfirmSkippedAt   DateTime?
  growthPointConfirmSkippedCost Int?
  // WHEN THIS PERSON LAST PROVED THEY ARE STILL THEMSELVES (Security & Trust,
  // 2026-08-22). A live session is not proof: it is what an attacker who
  // phished a password or stole a laptop is already holding. Every
  // security-sensitive action — turning 2FA off, regenerating recovery codes,
  // changing who can reach a business — requires a confirmation newer than
  // REAUTHENTICATION_WINDOW_MS, and clears it again on success so one
  // confirmation does not authorise an unbounded series of them.
  reauthenticatedAt DateTime?
  // TWO-FACTOR AUTHENTICATION (Security & Trust, 2026-08-22, D6: opt-in).
  //
  // The TOTP seed, ENCRYPTED AT REST with the same AES-256 helper that protects
  // integration credentials — it is a bearer secret exactly as those are, and
  // anyone holding it can mint valid codes forever. Null means 2FA has never
  // been set up on this account.
  totpSecret        String?
  // Null until the owner has proved they can produce a code from the secret.
  // A secret WITHOUT this is an abandoned enrolment, not protection: treating
  // one as enabled would lock somebody out with a code they never verified.
  totpEnabledAt     DateTime?
  recoveryCodes     RecoveryCode[]
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  accounts                   Account[]
  sessions                   Session[]
  stores                     Store[]
  draft                      StoreDraft?
  storeMemberships           StoreMember[]
  connectedIntegrations      StoreIntegration[]
  executionLogs              ExecutionLog[]
  productEvents              ProductEvent[]
  aiUsageEvents              AiUsageEvent[]
  referralsSent              Referral[]                  @relation("ReferralsSent")
  referralsReceived          Referral[]                  @relation("ReferralsReceived")
  businessPartnerTrialGrants BusinessPartnerTrialGrant[]
  passwordResetTokens        PasswordResetToken[]
  securityEvents             SecurityEvent[]
  userSessions               UserSession[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// Auth screens review (2026-08-07) — real password reset, restoring what
// git history confirms never existed in this codebase before (checked via
// `git log -S"Forgot Password"` across every commit — zero hits). Stores
// only a hash of the real token (tokenHash), same discipline as User.password
// — the raw token only ever exists in the email link itself, never at rest,
// so a database compromise alone can't be used to reset anyone's password.
// A fast cryptographic hash (SHA-256, not bcrypt) is correct here, unlike
// passwords: this token is high-entropy random data, not a low-entropy
// human-chosen secret, so it doesn't need slow, brute-force-resistant
// hashing the way a password does.
// Brute-force protection for the auth endpoints (2026-08-20).
//
// There was none: login, signup and password-reset requests could all be
// hammered without limit. A database table rather than in-memory counters
// because this runs on serverless — an in-process Map would reset on every cold
// start and would not be shared between concurrent instances, which is to say
// it would look like protection and provide none.
//
// `bucket` is a HASH of what is being limited, never the value itself. A table
// full of plaintext email addresses — including ones typed by attackers, which
// belong to real people who never signed up here — would be a liability created
// in the name of security.
model AuthAttempt {
  id         String   @id @default(cuid())
  bucket     String
  occurredAt DateTime @default(now())

  // Serves both the count-in-window query and the expiry sweep.
  @@index([bucket, occurredAt])
}

// WHAT HAPPENED TO AN ACCOUNT (Security & Trust, 2026-08-22).
//
// ACCOUNT-SCOPED, AND THAT IS THE WHOLE REASON THIS EXISTS SEPARATELY FROM
// ExecutionLog. ExecutionLog answers "what did Genesis do to this business" —
// it is keyed by storeId and its actor vocabulary is USER/GENESIS/SYSTEM.
// "Somebody signed in as me from a Mac at 4am" is not about a business and has
// no store to hang on; an account with three businesses has one sign-in
// history, not three. Putting these rows in ExecutionLog would have made every
// security question a per-business question, which is the wrong shape for the
// only thing an owner actually asks: what happened to MY account.
//
// APPEND-ONLY BY CONVENTION AND BY ABSENCE — there is no updatedAt, no status
// to move, and nothing in lib/security/ that updates or deletes a row. A
// security log that can be edited is a security log an attacker edits.
//
// Deliberately carries NO IP ADDRESS and no location (D4, approved). Device is
// a coarse label derived from the user-agent at write time — "Windows · Chrome"
// — never the raw string, which is a fingerprint. What an owner needs is enough
// to recognise their own session, not a dossier on themselves.
model SecurityEvent {
  id                String   @id @default(cuid())
  userId            String
  /// A value from SECURITY_EVENTS in lib/security/events.ts. A free String
  /// rather than an enum, matching ExecutionLog.action's own convention — but
  /// unlike that one, every value is asserted to have an owner-facing label,
  /// so a new kind cannot reach a merchant as a raw identifier.
  kind              String
  /// Coarse and human, e.g. "Windows · Chrome". Null when the event had no
  /// request behind it (a scheduled revocation, say) — which is a real
  /// difference from an unrecognised device and is kept distinguishable.
  device            String?
  /// Which sign-in this happened in, when there was one. Lets the history and
  /// the session list refer to the same thing.
  sessionInstanceId String?
  /// Anything specific the event needs — never a secret, asserted by suite.
  detail            Json?
  createdAt         DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// A SESSION AN OWNER CAN SEE AND END (Security & Trust, 2026-08-22, D1).
//
// Sessions stay JWTs. D1 was approved on exactly that basis: auth.ts already
// carries a working revocation mechanism — a token whose `iat` predates
// User.passwordChangedAt is refused on its next request, verified against
// Auth.js internals — and moving every user onto database sessions would be a
// rewrite of authentication to gain what extending that mechanism gains.
//
// So this row is NOT the session. It is a RECORD OF one, keyed by the
// sessionInstanceId the JWT already carries, and it exists to answer two
// questions the stateless token cannot: what is signed in, and has this
// particular one been revoked.
//
// REVOKED IS A TIMESTAMP, NOT A DELETED ROW. A deleted row cannot be told apart
// from a session that never existed, and the history needs to say "you signed
// out of a Mac on Tuesday" after the fact. Keeping it also means an eviction
// check can distinguish "revoked" from "unknown to us", which matters because
// they get different answers — see the resolver.
//
// No IP and no location, per D4 — same rule as SecurityEvent, and for the same
// reason. `device` is the coarse label, never the raw agent.
model UserSession {
  id                String    @id @default(cuid())
  userId            String
  /// The id minted into the JWT at sign-in. Unique because one sign-in is one
  /// session; a second row for the same instance would mean two answers to
  /// "is this revoked".
  sessionInstanceId String    @unique
  device            String?
  /// Moved forward on token refresh, which is the only signal a stateless
  /// session gives that somebody is still using it.
  lastSeenAt        DateTime  @default(now())
  /// Set when the owner ends this session. Null means live.
  revokedAt         DateTime?
  createdAt         DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, lastSeenAt])
}

// A ONE-TIME WAY BACK IN (Security & Trust, 2026-08-22).
//
// Threat case T5, and by volume the likeliest real incident once 2FA exists: an
// owner loses the phone holding their second factor. Getting this wrong locks a
// real business out of its own storefront and payments, which is why enrolment
// and recovery ship together and were never split.
//
// HASHED, exactly like a password, and for the same reason: a table of usable
// recovery codes is a table of passwords. Shown to the owner once at generation
// and never again — "regenerate" is the only path back, and it invalidates
// every previous code.
model RecoveryCode {
  id        String    @id @default(cuid())
  userId    String
  /// bcrypt of the code. The code itself is never stored anywhere.
  codeHash  String
  /// Set the moment it is spent. A used code is KEPT rather than deleted, so
  /// "you have 3 of 8 codes left" stays answerable and the history can say a
  /// code was used.
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Store {
  id                           String    @id @default(cuid())
  userId                       String
  name                         String
  slug                         String    @unique
  description                  String?
  tagline                      String?
  logoUrl                      String?
  theme                        Json?
  blueprint                    Json?
  pendingChange                Json?
  published                    Boolean   @default(false)
  version                      Int       @default(1)
  // Phase 3 Milestone 2 — code-level taxonomy slugs (lib/businessTaxonomy.ts),
  // never a Prisma enum: a String[] so a new category/subcategory is a
  // purely additive code change, matching ApprovalRequest.status's own
  // "avoid enum-migration friction" convention. Drives Recommended
  // Connections. Classified once at generation time (see ai-actions.ts's
  // CoreFieldsSchema); a real backfill for pre-existing stores is a later,
  // smaller addition.
  businessCategories           String[]  @default([])
  // Phase 3 Milestone 5 — same shape/reasoning as businessCategories above,
  // a second, independent classification axis: *how* the business makes
  // money (product_sales/service_fees/subscriptions/...), not *what
  // industry* it's in. See lib/businessTaxonomy.ts's REVENUE_STREAM_TYPES.
  revenueStreams               String[]  @default([])
  // Onboarding v2 — the owner's stated brand positioning (luxury/
  // streetwear/minimalist/budget/family/professional/other — see
  // lib/businessTaxonomy.ts's BRAND_POSITIONING_TYPES), a third,
  // independent classification axis: not *what* the business sells
  // (businessCategories) or *how* it makes money (revenueStreams), but
  // *what kind of brand* it is. Drives lib/fulfillment/strategy.ts's
  // selectFulfillmentStrategy() and lib/onboarding/pricing.ts's
  // recommendPrice() — a real branching input, not narrative flavor text
  // like blueprint.brandIdentity.brandPersonality.
  // THE BUSINESS'S OWN CURRENCY (2026-08-20, P0.5).
  //
  // Every money value belonging to this business — product costs, margins,
  // supplier minimums, the owner's investable capital — is in it. One per
  // business, and the assumption is named here rather than assumed everywhere:
  // no progression function reads a currency from anywhere else, and none sums
  // or compares across two. Lifting the one-per-business limit later is then a
  // contained change rather than an excavation.
  currency                     String    @default("USD")
  // WHAT THE OWNER HAS SAID THEY CAN INVEST (2026-08-20, P0.5).
  //
  // NEVER inferred from revenue. A business with real sales may have nothing
  // spare, and recommending a bulk order on the strength of turnover would be
  // Genesis telling somebody to spend money it has no idea they have.
  //
  // NULL means UNSTATED, which is NOT the same fact as a stated zero even
  // though both behave identically. The pair of columns is what keeps three
  // states apart: unstated (both null), explicitly zero (0 with a statedAt),
  // and explicitly positive. Collapsing the first two would destroy the only
  // signal that says "worth asking about".
  investableCapitalCents       Int?
  capitalStatedAt              DateTime?
  // Capabilities the owner has confirmed — holding stock, providing artwork,
  // managing a supplier. Absent means unknown, which is treated as "cannot" for
  // feasibility and as "worth asking" for everything else. Never inferred.
  ownerCapabilities            String[]  @default([])
  brandPositioning             String?
  // Onboarding v2, Creative Direction — the durable creative identity the
  // owner chose from Genesis's three generated directions: {name,
  // description, brandVoice, photographyStyle, colors, typography,
  // logoUrl, productImageUrl}. Deliberately separate from `theme` (which
  // stays the live-editable, chat-mutable rendering config) — this is the
  // less-frequently-changed "DNA" record a later phase will read from for
  // future creative work (marketing, social, packaging, future logos).
  // Null for the reselling/curating path and every store created before
  // this field existed.
  creativeDirection            Json?
  // Meeting with J4 M3 — set once, the moment the first real conversation
  // with J4 (after the Partnership launch ceremony, before the owner ever
  // sees the regular dashboard) completes. Checked once on load to decide
  // whether to show the meeting or redirect straight to /dashboard — never
  // re-triggered. Deliberately distinct from createdAt/updatedAt (neither
  // means "has this store ever met J4").
  firstMeetingCompletedAt      DateTime?
  // Business Partner Preview — the real 7-day trial of Business Partner's
  // unlimited-1-point-action tier, granted once at firstMeetingCompletedAt
  // (see lib/growthPoints/trial.ts). Null = never granted; a future
  // timestamp = active (checked by lib/growthPoints/ledger.ts alongside
  // Plan.unlimitedActionCostCeiling); a past timestamp = expired. The
  // durable, deletion-proof record of the grant itself lives in
  // BusinessPartnerTrialGrant below — this field is only the live check.
  businessPartnerTrialEndsAt   DateTime?
  // Progressive storefront improvement — the frequency governor (2026-08-12).
  // Stamped every time J4 raises an UNPROMPTED storefront-improvement
  // proposal, and read before he is allowed to raise another. This is what
  // makes "occasionally" a real product behaviour rather than a request in a
  // prompt: without it, nothing structurally prevents J4 from proposing a
  // redesign on every single review sweep.
  // Null = he has never suggested one, so the next one is always allowed.
  // Deliberately governs only J4's own initiative — a storefront change the
  // OWNER asks for in chat is never gated by this, because being asked is
  // not the same as volunteering. See lib/dashboard/storefrontSuggestionGate.ts.
  lastStorefrontSuggestionAt   DateTime?
  // Storefront Canvas, step 1 of 6 (2026-08-12) — which audience this
  // business actually serves, asked once during creation and changeable by
  // asking J4 later. "mobile" | "desktop" | "balanced"; null is treated as
  // balanced, so every existing store is already valid.
  //
  // Deliberately on Store rather than Theme: this is a fact about the
  // owner's customers, not a design token, and putting it on the theme
  // would imply it changes whenever the theme does.
  //
  // It influences J4's DECISIONS and never branches the renderer. That is
  // the whole reason one composition was chosen over separate desktop and
  // mobile compositions — the owner should never have to manage two
  // websites. Inert until step 4 reads it.
  priorityAudience             String?
  // Growth Points Economy (Chapter 2) — the store's real, spendable balance.
  // Debited by execute() when an approved GENESIS_ACTIONS action has a real
  // catalog cost (lib/growthPoints/catalog.ts), credited by the monthly
  // refresh sweep and referral rewards. Every change also writes one
  // GrowthPointTransaction row — this column is the current total, that
  // model is the append-only ledger explaining how it got there.
  growthPointBalance           Int       @default(0)
  // Nullable — no owner is assigned a real Plan yet (the catalog and every
  // Plan's allowance are still deliberately unpopulated, Sean's own
  // decision to make in a dedicated design session). A null planId means
  // "not on a plan," not "on a free plan with zero points" — the monthly
  // refresh sweep skips these stores entirely rather than pretending a
  // zero-value plan exists.
  planId                       String?
  // Set alongside planId once real plans exist; advanced by exactly one
  // calendar month each time the refresh sweep grants that plan's
  // allowance. Same "due timestamp stamped on the row" idiom as
  // StoreIntegration.nextSyncDueAt, not a new cadence mechanism.
  growthPointNextRefreshAt     DateTime?
  // Chapter 5 (Payments) — the platform's own Stripe Customer for this
  // store (Genesis billing the owner directly), entirely distinct from
  // StoreIntegration's STRIPE/PAYPAL rows (the merchant's own Connect
  // account for accepting THEIR customers' payments). Null until the
  // owner's first real billing interaction (a Growth Point purchase or a
  // plan subscription) — created lazily, not at store creation.
  stripeCustomerId             String?   @unique
  // Null until a real Stripe Subscription exists. Mirrors Stripe's own
  // status vocabulary verbatim (active/past_due/canceled/incomplete/
  // trialing/unpaid) as a plain String, not a Prisma enum — same
  // "avoid enum-migration friction" convention as ExecutionLog.status.
  stripeSubscriptionId         String?   @unique
  subscriptionStatus           String?
  // Kept in sync from Stripe's own customer.subscription.updated events —
  // never computed locally.
  subscriptionCurrentPeriodEnd DateTime?
  // Priority 2 (shipping, 2026-08-09) — the merchant's own "ship from"
  // address, required to buy a real USPS label (EasyPost needs a real
  // from_address, not just the customer's to_address already captured on
  // Order.shippingAddress). Same OrderShippingAddress shape
  // (lib/orders/shippingAddress.ts) plus name/phone, which a merchant
  // address requires but a customer's doesn't always have on file. Null
  // until the owner fills it in on Settings — label purchase is blocked
  // with an honest message until it's set, never a fabricated default.
  returnAddress                Json?
  createdAt                    DateTime  @default(now())
  updatedAt                    DateTime  @updatedAt

  user                      User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Accounts currently working in this business — practically 0 or 1: its owner,
  // plus any employee who last switched here.
  activeForUsers            User[]                     @relation("ActiveBusiness")
  plan                      Plan?                      @relation(fields: [planId], references: [id], onDelete: SetNull)
  products                  Product[]
  visions                   StoreGeneration[]
  orders                    Order[]
  messages                  StoreMessage[]
  subscribers               NewsletterSignup[]
  members                   StoreMember[]
  integrations              StoreIntegration[]
  executionLogs             ExecutionLog[]
  generatedRecommendations  GeneratedRecommendation[]
  approvalRequests          ApprovalRequest[]
  observations              GenesisObservation[]
  dismissedAttentionCards   DismissedAttentionCard[]
  postExecutionMeasurements PostExecutionMeasurement[]
  delegatedAuthorities      DelegatedAuthority[]
  productEvents             ProductEvent[]
  businessRecords           BusinessRecord[]
  recordRelationships       RecordRelationship[]
  businessEvents            BusinessEvent[]
  businessEventCursors      BusinessEventCursor[]
  cognitiveOutputs          CognitiveOutput[]
  beliefs                   Belief[]
  aiUsageEvents             AiUsageEvent[]
  growthPointTransactions   GrowthPointTransaction[]
  tasks                     Task[]
  sourcedProducts           SourcedProduct[]
  progressionDecisions      ProgressionDecision[]
  supplierEconomics         SupplierEconomics[]
  proactiveDeliveries       ProactiveDelivery[]
  conversations             Conversation[]
  promotions                Promotion[]
  checkoutDrafts            CheckoutDraft[]

  @@index([planId])
}

// The owner is still just Store.userId (unchanged) — this table is only for
// non-owner access (Employee today, more roles later) so existing
// single-owner flows and data are untouched. See lib/permissions.ts.
enum StoreRole {
  OWNER
  EMPLOYEE
}

model StoreMember {
  id        String    @id @default(cuid())
  storeId   String
  userId    String
  role      StoreRole
  createdAt DateTime  @default(now())

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([storeId, userId])
}

// Providers named across the roadmap (Stripe, PayPal) plus the ones raised
// as future examples (Google, Slack, USPS) — extending this later is a
// one-line enum addition, not a schema redesign. See lib/integrations/.
//
// Phase 3 Milestone 2 (Connector Framework) — GOOGLE_CALENDAR/QUICKBOOKS/
// MAILCHIMP added as the 3 proof integrations. GOOGLE itself is left
// reserved-but-unused rather than repurposed for Calendar specifically:
// @@unique([storeId, provider]) on StoreIntegration means each distinct
// integration *surface* needs its own identity, since a business could
// plausibly connect Calendar and (later) Gmail/Drive independently — a
// single shared "Google" value would make status ambiguous once a second
// Google surface exists.
enum IntegrationProvider {
  STRIPE
  PAYPAL
  GOOGLE
  SLACK
  // The provider is EasyPost; USPS is the carrier whose postage it buys. Renamed
  // from USPS on 2026-08-20 (ALTER TYPE ... RENAME VALUE, non-destructive).
  EASYPOST
  GOOGLE_CALENDAR
  QUICKBOOKS
  MAILCHIMP
  // Onboarding v2 — the first fulfillment-strategy connector (lib/fulfillment/).
  // Not the only one architecturally possible: lib/fulfillment/strategy.ts's
  // selectFulfillmentStrategy() evaluates whichever connectors are
  // registered, of which this is the first. See ONBOARDING_V2_DESIGN.md
  // section 6.
  PRINTFUL
  // Social Connections & Business Intelligence (2026-08-09) — Facebook and
  // Instagram are two independent StoreIntegration rows (each does its own
  // full OAuth against the Meta Graph API, matching every other connector's
  // self-contained lifecycle) even though they share low-level OAuth/token
  // helpers (lib/integrations/metaShared.ts) — a merchant genuinely may
  // want one without the other. TikTok is a separate app/API entirely.
  FACEBOOK
  INSTAGRAM
  TIKTOK
  // SMS to customers (2026-08-27). The first connector that produces no
  // business data at all -- it is a way to say something, not a thing to learn
  // from -- which the IntegrationConnector contract has always allowed and
  // nothing had yet exercised.
  TWILIO
  // Wholesale sourcing (2026-08-27). DISTINCT from the AliExpress entry in
  // lib/sourcing/registry.ts, which searches with Genesis's own app
  // credentials and involves no merchant. This is the per-merchant OAuth grant
  // AliExpress's dropshipping API requires in order to place an order against
  // that merchant's own account -- so their orders are paid from their money,
  // not fronted by Genesis.
  ALIEXPRESS
  // Point of sale, and the first connector to carry a CATALOG (2026-08-27).
  SQUARE
  // Accounting, as the alternative to QuickBooks for the businesses that do
  // not use it. Its refresh tokens ROTATE -- see capabilities.tokenLifetime.
  XERO
}

enum IntegrationStatus {
  CONNECTED
  NEEDS_ATTENTION
  FAILED
  DISCONNECTED
}

// One generic table for every provider — provider-specific detail lives in
// the opaque `credentials` Json, not as new columns per integration. Same
// shape philosophy as StoreMember.
model StoreIntegration {
  id                String              @id @default(cuid())
  storeId           String
  provider          IntegrationProvider
  status            IntegrationStatus   @default(DISCONNECTED)
  externalAccountId String?
  credentials       Json?
  connectedByUserId String?
  connectedAt       DateTime?
  lastVerifiedAt    DateTime?
  lastError         String?
  // Phase 3 Milestone 3 (Business Intelligence Engine) — sync *scheduling*
  // state, deliberately separate from status/lastVerifiedAt/lastError above
  // (connection *health* — is the credential valid — a different concern
  // from sync *cadence*). nextSyncDueAt is what makes the scheduler
  // trigger-frequency-agnostic: computed once per attempt, independent of
  // how often the cron route itself gets invoked — see lib/intelligence/
  // scheduler.ts. Full sync attempt history lives in ExecutionLog
  // (already written by syncExecutable), not duplicated here.
  lastSyncedAt      DateTime?
  nextSyncDueAt     DateTime?
  syncFailureCount  Int                 @default(0)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  store       Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
  connectedBy User? @relation(fields: [connectedByUserId], references: [id], onDelete: SetNull)

  @@unique([storeId, provider])
  @@index([status, nextSyncDueAt])
}

model StoreDraft {
  id                    String   @id @default(cuid())
  // Experience-First Onboarding — nullable now. A draft is owned by EITHER
  // a real userId (the activation flow, today's exact existing behavior)
  // OR an anonymousSessionToken below, never neither, briefly both during
  // claim (see the claim step in app/onboarding/actions.ts, which sets
  // userId and clears anonymousSessionToken as one atomic update — the row
  // itself is never recreated). Postgres treats multiple NULLs as distinct
  // under a unique constraint, so many anonymous drafts can coexist.
  userId                String?  @unique
  // Experience-First Onboarding — the signed, anonymous-session identity
  // (lib/onboarding/anonymousSession.ts) that owns this draft before a
  // real account exists. Null once claimed. Never set alongside a real
  // userId for longer than the single claim update.
  anonymousSessionToken String?  @unique
  inputStoreName        String?
  inputProductType      String?
  inputVision           String?
  name                  String
  description           String?
  tagline               String?
  theme                 Json?
  productsDraft         Json?
  blueprint             Json?
  pendingChange         Json?
  status                String   @default("draft")
  version               Int      @default(1)
  // Phase 3 Milestone 2 — see Store.businessCategories's own comment; this
  // is the draft-stage copy, carried over to Store at confirmStoreDraft.
  businessCategories    String[] @default([])
  // Phase 3 Milestone 5 — see Store.revenueStreams's own comment; same
  // draft-stage-copy pattern as businessCategories above.
  revenueStreams        String[] @default([])
  // Onboarding v2 — see Store.brandPositioning's own comment; same
  // draft-stage-copy pattern as businessCategories/revenueStreams above.
  brandPositioning      String?
  // Onboarding v2, Creative Direction — see Store.creativeDirection's own
  // comment; same draft-stage-copy pattern, carried over verbatim at
  // confirmStoreDraftCore.
  creativeDirection     Json?
  // Onboarding v2 — the guided discovery flow's own state machine progress
  // (current step, classifications made so far, the chosen fulfillment
  // candidate/variant) and, while no real Store/StoreIntegration exists yet
  // to hold them, encrypted fulfillment OAuth credentials (see
  // ONBOARDING_V2_IMPLEMENTATION.md section 4 — confirmStoreDraftCore
  // materializes the real StoreIntegration row atomically at confirm,
  // mirroring how productsDraft -> Product already works). Deliberately
  // separate from pendingChange — that's one AI-authored diff awaiting
  // confirm; this is "where the guided conversation currently is," a
  // different kind of state that persists across many turns.
  onboardingState       Json?
  // Experience-First Onboarding — the anonymous experience flow's own state
  // (transcript so far, and the generated concept once confident), entirely
  // separate from onboardingState above: that field belongs to the
  // activation flow's guided-discovery state machine and is untouched by
  // this phase. See lib/onboarding/types.ts's ExperienceState for the real
  // shape. Cleared conceptually once claimed, though the field itself is
  // simply never read again after that point (see the claim step in
  // app/onboarding/actions.ts).
  experienceState       Json?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  user          User?               @relation(fields: [userId], references: [id], onDelete: Cascade)
  generations   StoreGeneration[]
  messages      StoreDraftMessage[]
  executionLogs ExecutionLog[]
}

model StoreDraftMessage {
  id           String   @id @default(cuid())
  storeDraftId String
  role         String
  content      String
  changes      Json?
  createdAt    DateTime @default(now())

  storeDraft StoreDraft @relation(fields: [storeDraftId], references: [id], onDelete: Cascade)
}

/// A conversation, as UI6 defines one: an explicit, persistent thread.
///
/// NOT A TASK, and not a time window. J4 has to hold conversations about
/// products, customers, documents, decisions, questions and problems —
/// anchoring identity on tasks would have forced every one of those to become a
/// task in order to exist. An anchor is optional metadata; identity is this row.
///
/// DELIBERATELY SMALL. There is no closedAt, no archivedAt and no generated
/// title, because none was decided — and a column that could hold one is not a
/// reason to build the behaviour behind it.
model Conversation {
  id      String  @id @default(cuid())
  storeId String
  /// Optional, and supplied by the owner. Nothing generates it: a J4-titled
  /// thread would make this milestone depend on a model credential, and nothing
  /// else in it does.
  name    String?
  /// OPTIONAL CONTEXT, NEVER IDENTITY. Removing the anchor must leave the
  /// conversation and its messages exactly where they are — SetNull, not
  /// Cascade, and the suite asserts it.
  taskId  String?

  createdAt DateTime @default(now())

  store    Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  task     Task?          @relation(fields: [taskId], references: [id], onDelete: SetNull)
  messages StoreMessage[]

  @@index([storeId, createdAt])
  @@index([taskId])
}

model StoreMessage {
  id        String   @id @default(cuid())
  storeId   String
  role      String
  content   String
  changes   Json?
  createdAt DateTime @default(now())

  // BUSINESS_ASSETS_ARCHITECTURE.md M2 — set on the real, persisted opening
  // turn a Task card writes (see startTaskConversation, app/dashboard/
  // ai-actions.ts). This is what replaces the old ephemeral, client-only
  // focusedContext banner: because it's a real row in the same message
  // history every turn already reads in full, "J4 already understands why
  // the task exists" is true for the whole conversation, not just its first
  // render — no separate context-injection mechanism needed.
  taskId String?

  // WHAT ACTUALLY HAPPENED WHEN J4 SAID THIS (UI6, 2026-08-23).
  //
  // An assistant message is prose. The execution row written in the same breath
  // is the truth: SUCCESS, PENDING because something is only proposed, WARNING
  // because it did not go through. Until now nothing joined them, so the
  // conversation could only render the words — and the words are written before
  // anybody knows whether a later reader is looking at a change that landed, a
  // change still waiting, or a change that failed and was retried since.
  //
  // Nullable, and most rows have none: an ordinary reply, the merchant's own
  // message, and every message written before this existed. A missing link
  // means "no execution to speak of", never "it succeeded".
  //
  // SetNull rather than Cascade — losing the record of what happened must not
  // delete what J4 said about it.
  executionLogId String?

  /// WHICH CONVERSATION THIS BELONGS TO, when it belongs to one (UI6 piece 2).
  ///
  /// Nullable and NEVER BACKFILLED. Every message written before conversations
  /// existed keeps a null, and null means exactly that — no conversation was
  /// recorded — rather than a manufactured one. The grouping did not exist when
  /// those rows were written, and inventing one would be inventing history, the
  /// same call made for executionLogId above.
  conversationId String?

  store               Store               @relation(fields: [storeId], references: [id], onDelete: Cascade)
  task                Task?               @relation(fields: [taskId], references: [id], onDelete: SetNull)
  executionLog        ExecutionLog?       @relation(fields: [executionLogId], references: [id], onDelete: SetNull)
  proactiveDeliveries ProactiveDelivery[]
  conversation        Conversation?       @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  @@index([taskId])
  @@index([executionLogId])
  @@index([conversationId])
}

model StoreGeneration {
  id              String   @id @default(cuid())
  storeDraftId    String?
  storeId         String?
  version         Int
  promptVersion   String   @default("v1")
  milestone       String?
  generatedOutput Json
  createdAt       DateTime @default(now())

  storeDraft StoreDraft? @relation(fields: [storeDraftId], references: [id], onDelete: Cascade)
  store      Store?      @relation(fields: [storeId], references: [id], onDelete: Cascade)
}

model Product {
  id                  String               @id @default(cuid())
  storeId             String
  name                String
  description         String?
  richContent         Json?
  priceInCents        Int
  imageUrl            String?
  active              Boolean              @default(true)
  position            Int                  @default(0)
  // Onboarding v2 — present only for a product sourced through a
  // fulfillment strategy (see lib/fulfillment/), null for a manually
  // entered product with no known cost. fulfillmentProvider/
  // externalProductId/externalVariantId together record *that* a product
  // is fulfilled externally and by which connector's catalog entry,
  // without yet building the "route the order to the supplier
  // automatically" execution logic (a real, separate, later capability —
  // see ONBOARDING_V2_DESIGN.md's non-goals). No variant model exists on
  // Product — externalVariantId records the one representative catalog
  // variant Genesis selected, not a full variant system.
  costInCents         Int?
  // Parcel dimensions for live shipping rates (EasyPost, 2026-08-20). Nullable
  // because most products predate this and because a digital or
  // owner-fulfilled item genuinely has none — a null here means "cannot rate
  // this", never "weighs nothing".
  weightOz            Float?
  lengthIn            Float?
  widthIn             Float?
  heightIn            Float?
  fulfillmentProvider IntegrationProvider?
  externalProductId   String?
  externalVariantId   String?
  // WHERE THIS PRODUCT COMES FROM (2026-08-20, P0.5).
  //
  // fulfillmentProvider above records *which connector* a product came
  // through, which is a different and narrower question: it is null for
  // everything Cubit & Coil actually sells, because Sean makes tensor rings
  // himself. That leaves the platform unable to tell an owner-made product
  // from a dropshipped one — and they behave differently in ways the code
  // already cares about. Who buys the shipping label. Whether there is stock to
  // run out of. Whether "customize this" means anything. What the cost basis is.
  //
  // Defaulted to OWNER_MADE because that is the truth about every product that
  // exists today: each one was entered by hand by the person who makes or holds
  // it. Nothing is backfilled or inferred.
  // WHAT WAS DESIGNED, FROZEN AT THE MOMENT IT WAS ADDED (2026-08-27).
  //
  // The Creation Station's own design document: the artwork on each placement,
  // in normalised coordinates, PLUS the provider positions already resolved
  // against the supplier's print areas at that instant.
  //
  // Both halves are stored on purpose. The normalised design is what can be
  // reopened and edited; the resolved positions are what the supplier was
  // going to be told. Keeping only the first would mean re-deriving placement
  // from a catalogue that may since have changed a print area -- and a product
  // whose print position quietly moved is one nobody would notice until it
  // arrived wrong.
  //
  // Null for every product not made here, which is all of them today.
  designSpec          Json?
  sourceKind          ProductSourceKind    @default(OWNER_MADE)
  // Which registered source this came from (lib/sourcing/registry.ts), e.g.
  // "printful". A plain string, not an enum, for the same reason the business
  // taxonomy is not one: adding a supplier should be a registry entry, not a
  // migration. Null for anything the owner brought themselves.
  sourceKey           String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  store                Store                 @relation(fields: [storeId], references: [id], onDelete: Cascade)
  orders               Order[]
  images               ProductImage[]
  sourcedFrom          SourcedProduct[]
  progressionDecisions ProgressionDecision[]
  promotions           PromotionProduct[]
  orderItems           OrderItem[]
}

// How a product comes into existence and reaches the customer.
//
// Not a taxonomy of suppliers — a taxonomy of BEHAVIOUR, which is why it is an
// enum rather than a string: every value here changes what other code must do,
// and a value nobody handles should fail to compile rather than fall through.
enum ProductSourceKind {
  // The owner makes or holds it, and ships it. Cubit & Coil's tensor rings.
  OWNER_MADE
  // Printed or customised per order by a partner, who ships it. Printful.
  // The only kind for which "customise this" is a real capability.
  PRINT_ON_DEMAND
  // Bought from a wholesaler who ships direct to the customer. AliExpress.
  // The owner never touches it and never buys a label for it.
  WHOLESALE_DROPSHIP
  // Bought wholesale, held by the owner, shipped by the owner. Has stock.
  WHOLESALE_STOCKED
  // Nothing ships. No parcel, no label, no address.
  DIGITAL
  // BOUGHT IN BULK WITH THE OWNER'S OWN BRANDING ON IT (2026-08-20, P0.5).
  //
  // Rung 2. Real capital, a real minimum, and stock that cannot be resold
  // generically if it does not move — which is what separates it from
  // WHOLESALE_STOCKED above.
  //
  // Added with no connector behind it, deliberately. The rung has to exist in
  // the model before a supplier for it does; the reverse is how one supplier's
  // shape ends up dictating the architecture. See PRODUCT_PROGRESSION.md.
  PRIVATE_LABEL
  // Rung 3. Made to the owner's own specification by a manufacturer they
  // manage. Distinct from OWNER_MADE, which is the owner making it themselves.
  CONTRACT_MANUFACTURED
}

// A product Genesis has FOUND, from any source — not one the store sells.
//
// The distinction is the whole point of this table. A catalog is a list of what
// a store sells; discovery is a standing conversation about what it could sell,
// and that conversation has to survive the page it happened on. Before this,
// browsing a supplier's catalog produced candidates that existed only inside one
// request: J4 could not come back to them, could not explain why it had raised
// one, and could not tell a suggestion the owner had already rejected from one
// it had never seen.
//
// Deliberately store-scoped rather than global. The same Printful blank is a
// different proposition for a streetwear brand than for a wellness one, and the
// reasoning attached to it is about THIS business.
model SourcedProduct {
  id                String @id @default(cuid())
  storeId           String
  // Which registered source, and that source's own ids. Together with storeId
  // these make re-running discovery an update in place rather than a pile of
  // duplicates — the same idempotency-by-construction the sync layer uses.
  sourceKey         String
  externalProductId String
  // Part of the key, so two variants of one product are two candidates.
  //
  // NON-NULL, with "" meaning "this source has no variants at all" — which a
  // wholesale listing frequently does not, where a print-on-demand blank always
  // does. Nullable would have been the natural modelling and is wrong here for
  // two compounding reasons: Postgres treats NULLs in a unique index as
  // distinct, so every re-run of discovery would have inserted another copy of
  // every variant-less candidate; and Prisma cannot target a compound unique
  // containing a null, so the upsert that makes discovery idempotent could not
  // be written at all. The sentinel is converted back to null at the one place
  // it reaches a Product (lib/sourcing/adopt.ts).
  externalVariantId String @default("")

  kind                   ProductSourceKind
  name                   String
  description            String?
  imageUrl               String?
  // What the supplier charges. Null when the source will not quote without a
  // credential — an unknown cost is recorded as unknown, never as zero.
  unitCostInCents        Int?
  // Suggested, never imposed. The owner prices their own store.
  suggestedRetailInCents Int?
  currency               String               @default("USD")
  // True only where the source can genuinely put the owner's artwork on it.
  // A wholesale listing is not customisable and must never be offered as if it
  // were — this is the field that keeps those two shapes apart downstream.
  customizable           Boolean              @default(false)
  // Which integration will actually fulfil an order for this, if any. Recorded
  // at discovery so adoption never has to re-resolve a source — which would be
  // both wrong (there is more than one possible print partner) and fragile (a
  // de-registered source would strand a suggestion the owner is looking at).
  // SUPPLIER ECONOMICS (2026-08-20, P0.5) — what the supplier stated, and
  // nothing else. NULL means the supplier did not say.
  //
  // Never defaulted, averaged, or derived from unitCostInCents. An unknown
  // minimum blocks a bulk recommendation rather than becoming a free one, which
  // is the difference between a system that says "I don't know what this would
  // cost you" and one that quietly says "nothing".
  minimumOrderUnits      Int?
  bulkUnitCostInCents    Int?
  leadTimeDays           Int?
  fulfillmentProvider    IntegrationProvider?

  // WHY J4 RAISED THIS. Written by the recommender, read by the owner-facing
  // surface, and kept as Json for the same reason Store.blueprint is: the shape
  // of an explanation will change as J4's understanding deepens, and that should
  // not be a migration each time. Null for a candidate nobody has reasoned about
  // yet — which is honest, and distinguishable from a score of zero.
  recommendation Json?
  // Ordering for the owner-facing list. Denormalised out of `recommendation` so
  // the database can sort without parsing Json. Null = not yet scored.
  score          Int?

  // SUGGESTED until the owner does something. DISMISSED is remembered so the
  // same candidate is never raised twice, which is the difference between a
  // partner and a nag. ADOPTED points at the Product it became.
  status           SourcedProductStatus @default(SUGGESTED)
  adoptedProductId String?

  discoveredAt DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  dismissedAt  DateTime?

  store   Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  // SetNull, not Cascade: deleting a product the owner adopted must not erase
  // the record that Genesis found it, or discovery would offer it straight back.
  adopted Product? @relation(fields: [adoptedProductId], references: [id], onDelete: SetNull)

  @@unique([storeId, sourceKey, externalProductId, externalVariantId])
  @@index([storeId, status, score])
}

// THE OWNER'S ANSWER TO A GRADUATION (2026-08-20, P0.5).
//
// A graduation is derived from evidence, but the answer to one has to persist or
// it is offered again next week. See PRODUCT_PROGRESSION.md §G and §H.
model ProgressionDecision {
  id            String                  @id @default(cuid())
  storeId       String
  productId     String
  /// The rung that was offered.
  toKind        ProductSourceKind
  decision      ProgressionDecisionKind
  /// Which policy version produced the offer. A later threshold change does not
  /// rewrite this — it means the next offer was judged differently, and the
  /// record says which. Evidence and policy are separate; so is their history.
  policyVersion String
  /// The CONDITIONS as they stood, not just the evidence: capital, capabilities,
  /// supplier minimum and price, demand, margin, source availability, currency.
  /// This is what "has anything material changed" is answered against, and it is
  /// why reconsideration is not a percentage — an owner who said no to £1,400
  /// has not changed their mind because units went up, but may well have because
  /// the supplier dropped its minimum. Json for the same reason `recommendation`
  /// is: the set of conditions will grow.
  conditions    Json
  decidedAt     DateTime                @default(now())

  store   Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([storeId, productId])
}

enum ProgressionDecisionKind {
  ACCEPTED
  DECLINED
}

// WHAT A SUPPLIER'S PRODUCT ACTUALLY COSTS (2026-08-20, P0.5).
//
// The progression engine can reason about minimums, bulk pricing and margins;
// until now nothing in production could tell it any of those. This is where they
// live, and its shape is decided by three things it must never do.
//
// IT MUST NEVER LET ONE SUPPLIER'S ECONOMICS REACH ANOTHER'S PRODUCT. Identity
// is (business, source, product, variant) — all four. An external id alone is
// not an identity: two suppliers can and do use the same one, and a minimum of
// 5000 landing on a product whose real minimum is 50 is a wrong number about
// money that nobody would catch.
//
// IT MUST NEVER TURN UNKNOWN INTO ZERO. Every figure is nullable, and absence is
// carried through the whole pipeline as `cannot_assess` rather than as a free
// or infinitely-profitable product.
//
// IT MUST SAY WHERE A NUMBER CAME FROM. A price a supplier published and a price
// the owner was quoted on the phone are both usable and are not the same fact —
// one can be refreshed, the other has to be re-asked.
/// Every outbound request Genesis makes to a supplier, and why.
///
/// A THIRD AXIS, deliberately separate from AiUsageEvent and
/// GrowthPointTransaction. Supplier HTTP is not AI cost — every column of
/// AiUsageEvent is about tokens and models — and it is not Growth Point spend,
/// because charging an owner for work Genesis chose to do unprompted would be a
/// lie that balances. Keeping it apart is what makes any of the three readable.
model SupplierRequestEvent {
  id String @id @default(cuid())

  /// The business the request was made on behalf of. Null for a call with no
  /// business behind it, which is a real state rather than a gap.
  storeId    String?
  /// The registered source (lib/sourcing/registry.ts), e.g. "printful".
  sourceKey  String
  /// What was being asked for — "search", "economics.quote", "cost". Free text
  /// rather than an enum: this is a ledger to read, not a thing to branch on.
  operation  String
  ok         Boolean
  durationMs Int

  /// The unattended pass this belonged to, or null when a person triggered it.
  /// What separates "Genesis spent this on its own" from "somebody asked".
  runId String?

  occurredAt DateTime @default(now())

  @@index([storeId, occurredAt])
  @@index([runId])
}

model SupplierEconomics {
  id                String @id @default(cuid())
  storeId           String
  /// The registered source (lib/sourcing/registry.ts), e.g. "printful".
  sourceKey         String
  /// The supplier's own ids. "" is the no-variant sentinel, same as
  /// SourcedProduct — a listing with no variants must match the row with no
  /// variant, not the first variant of something else.
  externalProductId String
  externalVariantId String @default("")

  /// What currency these figures are in.
  ///
  /// EXPLICIT, never assumed from the business. A supplier who quotes in EUR to
  /// a business that sells in USD has stated a real fact, and reading it as USD
  /// would be a wrong number about money that looks exactly like a right one.
  /// Written from the owning Store at ingest; feasibility refuses to compare
  /// across currencies rather than applying a rate nobody supplied.
  currency String

  // PROVENANCE IS PER FACT, NOT PER ROW (2026-08-21).
  //
  // One row, several facts, and they do not arrive together. A catalogue can
  // publish a price and say nothing about the minimum; the owner then rings and
  // is told the minimum. Under one provenance column those two could not
  // coexist: the owner's answer either overwrote the supplier's price or was
  // stamped with the supplier's name. Both are lies about where a number came
  // from, and a number about somebody's money is exactly where that matters.
  //
  // Each fact below therefore carries its own provenance, its own statedAt (so
  // freshness is judged per fact — a price from this morning is not made stale
  // by a minimum from February) and its own author. A NULL provenance means
  // nobody has said anything about that fact, which is the honest starting
  // state and is different in kind from a stated UNAVAILABLE.
  //
  // A VALUE WITHOUT A PROVENANCE IS NOT A VALUE. Nothing writes one; the reader
  // treats the pair as unusable and says so, the same way it treats malformed
  // price breaks.

  /// The smallest order the supplier will take.
  minimumOrderUnits      Int?
  minimumOrderProvenance EconomicsProvenance?
  minimumOrderStatedAt   DateTime?
  minimumOrderStatedById String?

  /// What one unit costs at that minimum. Never zero for unknown.
  unitCostInCents    Int?
  unitCostProvenance EconomicsProvenance?
  unitCostStatedAt   DateTime?
  unitCostStatedById String?

  /// Price breaks, [{ minUnits, unitCostInCents }]. NULL = none stated, which is
  /// different from a supplier that has no breaks (an empty array). Json because
  /// the shape of a price break varies by supplier and a table of two columns
  /// per tier would be a join for no reason.
  tiers           Json?
  tiersProvenance EconomicsProvenance?
  tiersStatedAt   DateTime?
  tiersStatedById String?

  /// Delivery per unit on a bulk order. A stated 0 means "included" and is not
  /// the same as unknown.
  shippingPerUnitInCents Int?
  shippingProvenance     EconomicsProvenance?
  shippingStatedAt       DateTime?
  shippingStatedById     String?

  /// How long the supplier takes, and what this product demands of the owner
  /// beyond its method's own — an oversized item needing real storage, say.
  /// One fact: both describe what handling this product involves, and nobody
  /// states one without the other being part of the same conversation.
  leadTimeDays         Int?
  requiresCapabilities String[]             @default([])
  handlingProvenance   EconomicsProvenance?
  handlingStatedAt     DateTime?
  handlingStatedById   String?

  /// Free text the owner added — "quoted by email 12 Aug". Never parsed.
  note String?

  /// When this row was last touched by anything. Audit only: every decision
  /// reads the per-fact statedAt above, because "when did somebody tell us the
  /// price" and "when did this row last change" are different questions.
  updatedAt DateTime @default(now()) @updatedAt

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, sourceKey, externalProductId, externalVariantId])
  @@index([storeId, sourceKey])
}

enum EconomicsProvenance {
  /// The supplier's own API or catalogue said so.
  SUPPLIER
  /// The owner found out and told Genesis. Just as real, and re-asked rather
  /// than refreshed.
  OWNER
  /// Somebody looked and there is no answer to be had. Distinct from never
  /// having looked: this one should not be asked about again immediately.
  UNAVAILABLE
}

enum SourcedProductStatus {
  SUGGESTED
  DISMISSED
  ADOPTED
  /// Genesis looked at it and decided against it, and can say why.
  ///
  /// Distinct from DISMISSED, which is the OWNER's decision. Conflating them
  /// would let Genesis's own judgement read back later as something the owner
  /// had turned down — and the two need completely different handling: a
  /// dismissal is respected forever, this one is re-evaluated every time the
  /// business's own description changes.
  RULED_OUT
}

// Product media gallery (2026-08-08) — up to 10 images per product,
// ordered. position 0 is the primary image; "reorder" and "make primary"
// are deliberately the same real operation (move to position 0), not two
// separate mechanisms. Product.imageUrl is kept, unchanged in shape,
// deliberately: it's now a denormalized mirror of this table's own
// position-0 row, kept in sync by every write path (see
// lib/execution/executables/productImages.ts). That one decision is what
// lets every existing reader of Product.imageUrl — the storefront hero,
// the homepage fallback, the admin list, the chat regenerate flow, AI
// image generation — keep working completely unchanged, automatically
// showing the correct primary image, with zero migration needed on their
// side. This table is the new, additional source of truth for ordering
// and the additional (non-primary) images only.
model ProductImage {
  id        String   @id @default(cuid())
  productId String
  url       String
  position  Int      @default(0)
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, position])
}

model NewsletterSignup {
  id        String   @id @default(cuid())
  storeId   String
  email     String
  createdAt DateTime @default(now())

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, email])
}

// paymentProvider/externalOrderId are provider-agnostic (PH-06) — replaced
// the Stripe-specific stripeSessionId column so a PayPal order (or any
// future provider's) has an equally first-class identity, not a shoehorned
// one. Composite-unique rather than a bare unique on externalOrderId, so
// two providers' ids can never collide.
model Order {
  id                          String               @id @default(cuid())
  storeId                     String
  productId                   String?
  productName                 String
  // HOW MANY UNITS THIS ORDER IS FOR (2026-08-20, P0.5).
  //
  // Progression evidence counts units, not orders: one order for 100 is not the
  // same evidence as 100 orders for one, and a bulk-purchase recommendation
  // built on the wrong one would tell an owner to buy a case on the strength of
  // a single sale.
  //
  // Defaulting to 1 is not a guess. Every order this platform has ever written
  // came from a checkout that sells one product with no quantity control, so
  // each genuinely is one unit — the default records what was already true
  // rather than inventing a value.
  //
  // amountInCents stays the ORDER TOTAL. Per-unit revenue is amountInCents /
  // quantity, computed where needed and never stored twice.
  quantity                    Int                  @default(1)
  amountInCents               Int
  buyerEmail                  String
  status                      String               @default("paid")
  paymentProvider             IntegrationProvider
  externalOrderId             String
  // Real gap closed (2026-08-09) — refunds had nowhere to attach: Order was
  // only ever keyed by the CHECKOUT-level id (externalOrderId, a Stripe
  // Checkout Session id), but a refund webhook (charge.refunded) arrives
  // keyed by payment_intent, one level down. Nullable (a future non-Stripe
  // provider, or an order created before this field existed, may not have
  // one) and unique-when-set so a refund event can look its Order up
  // directly rather than re-deriving it from metadata a second time.
  externalPaymentId           String?
  // Implementation roadmap Milestone 1 — a real, fulfillable business needs
  // a real shipping address; neither checkout path collected or stored one
  // before this. Normalized to one common shape regardless of provider
  // (see lib/orders/shippingAddress.ts) so the owner-facing order view
  // (Milestone 4) never has to branch on paymentProvider to read it.
  // Nullable: a digital-goods order (no such path exists yet, but the
  // field shouldn't assume every future Order is physical) has none.
  shippingAddress             Json?
  // THE ADDRESS USED FOR FULFILMENT — which is what this has always been, now
  // said out loud because there is a second address next to it.
  //
  // What the customer typed, kept ONLY when verification changed it. Null means
  // nothing was changed, so storing a duplicate would be noise; this column
  // answers "what did we alter?" rather than "what was typed?".
  shippingAddressEntered      Json?
  // verified | unverified | not_checked. Not derivable from the column above:
  // with no entered address on file, "confirmed and needed no correction" and
  // "nobody looked" are indistinguishable, and a merchant about to buy postage
  // deserves to know which.
  shippingAddressVerification String?
  // Owner-experience milestone — the owner's own manual acknowledgment that
  // an order has been fulfilled (shipped through Printful's own dashboard,
  // self-fulfilled, or otherwise). Deliberately separate from `status`
  // above, which tracks payment/refund state, a different axis entirely.
  // V1 is manual-only by Sean's explicit choice: no automatic real-money
  // order placement with a fulfillment connector yet — that's an explicit,
  // later Phase 2 capability, not an oversight.
  fulfillmentStatus           String               @default("unfulfilled")
  fulfilledAt                 DateTime?
  // WAS THE CUSTOMER ACTUALLY TOLD? (2026-08-20)
  //
  // A fourth axis, and deliberately not folded into any of the three above.
  // `status` is payment, `fulfillmentStatus` is the owner's acknowledgment, and
  // carrier/trackingNumber mean a label exists — none of them says whether the
  // person who paid has heard anything. Before these fields that question had
  // no answer anywhere in the system, so a notification could be sent twice on
  // a webhook replay and nobody could tell an un-notified order from a notified
  // one.
  //
  // Both are the CLAIM in a claim-then-send: set before the attempt so a
  // concurrent delivery cannot also send, and cleared again if the send fails
  // so a later retry can. See lib/orders/orderConfirmation.ts.
  confirmationSentAt          DateTime?
  shipmentNotifiedAt          DateTime?
  // The OWNER was told a sale happened (2026-08-22). A fifth state, kept apart
  // from the four orderConfirmation.ts already names: an order can be paid,
  // confirmed to the customer, shipped and tracked while its owner has never
  // once been told it exists. Null means not told — true of every order
  // predating this column, and the honest reading rather than a backfilled
  // claim that somebody was emailed.
  ownerNotifiedAt             DateTime?
  // The claim that stops one shipment being paid for twice (2026-08-20).
  //
  // purchaseShippingLabelExecutable guarded on `trackingNumber` — but that is
  // only written AFTER the label is bought, and several awaits separate the
  // check from the purchase. Two concurrent submits both passed the check and
  // both reached EasyPost, so the merchant paid real postage twice for one
  // parcel. Set before any EasyPost call and cleared if the purchase fails, so
  // a genuine retry is still possible.
  labelClaimedAt              DateTime?
  // Priority 2 (shipping, 2026-08-09) — set together, only by a real,
  // owner-triggered EasyPost label purchase (lib/execution/executables/
  // shipping.ts). Nullable: unset for every order until the owner
  // explicitly buys a label — this never happens automatically on
  // payment, matching fulfillmentStatus's own "manual, owner-triggered"
  // precedent above (now extended to a step that spends real money on
  // postage, so it must stay an explicit action more than ever).
  carrier                     String?
  trackingNumber              String?
  trackingUrl                 String?
  labelUrl                    String?
  // What the LABEL cost the owner. Written only when a label is purchased.
  // Read by M7 profitability — do not conflate with what the customer paid.
  // WHERE THE PARCEL ACTUALLY IS (Shipping & Fulfilment, 2026-08-22, S3).
  //
  // The last arrow of the commerce chain, and the one that has never had an
  // answer. Until now the system knew a label had been bought and a tracking
  // number existed; whether the thing ARRIVED was unknowable, so the order
  // lifecycle stopped at "shipped" and stayed there forever.
  //
  // Written only by the carrier's own tracking updates — never inferred from
  // elapsed time, which would be Genesis guessing at somebody's delivery.
  // Null throughout means no carrier has told us anything yet, which is a
  // different fact from "not delivered" and is kept distinguishable.
  //
  // The vocabulary is lib/businessModel/entities.ts's ShipmentSchema.status,
  // a free string for the reason that file already documents: a carrier
  // inventing a new state must not break ingestion.
  shipmentStatus              String?
  deliveredAt                 DateTime?
  lastScanAt                  DateTime?
  shippingCostInCents         Int?
  // WHAT WAS ACTUALLY IN THE BOX (2026-08-26).
  //
  // Product.weightOz and its three dimensions are the owner's standing
  // estimate. These are the parcel a label was really bought against — the
  // numbers in the label form at the moment postage was paid for, which the
  // owner may well have changed after packing it.
  //
  // Recorded because "the packaged dimensions used for shipping" is a fact
  // about THIS order, not about the product: two orders for the same item can
  // genuinely ship in different boxes, and only one of them can be the
  // product's saved estimate.
  // WHERE THIS ORDER'S LINE ITEMS CAME FROM (2026-08-26). See
  // OrderLineItemSource — a contents-unknown order must not read as pure margin.
  // Null on every order written before bags existed, all of which have exactly
  // one product recorded on the row itself.
  lineItemSource              OrderLineItemSource?
  // The draft this order was written from, when there was one.
  checkoutDraftId             String?
  parcelWeightOz              Float?
  parcelLengthIn              Float?
  parcelWidthIn               Float?
  parcelHeightIn              Float?
  // What the CUSTOMER chose and was charged at checkout (2026-08-20). The gap
  // between this and shippingCostInCents is the store's shipping margin.
  shippingChargedInCents      Int?
  selectedShippingCarrier     String?
  selectedShippingService     String?
  selectedShippingRateId      String?
  selectedShippingEstDays     Int?
  // WHAT THIS ORDER ACTUALLY COST, AND WHY (2026-08-26).
  //
  // amountInCents above stays the ORDER TOTAL, unchanged and still whatever the
  // provider settled. These record how it was arrived at, which nothing could
  // say before: a discounted order was indistinguishable from a cheap one, and
  // profitability read the discount as thinner margin with no attribution.
  //
  // Null on every order that predates promotions and on every order that used
  // none — "no discount" and "we did not record discounts yet" are the same
  // absence here, and both correctly mean the customer paid list price.
  listSubtotalInCents         Int?
  discountInCents             Int?
  // FROZEN AT PURCHASE, ON PURPOSE. The label and code are copied onto the
  // order rather than read back through the relation, so an order stays true
  // after the merchant renames the sale, edits its percentage, switches it off
  // or deletes it outright. The relation below is SetNull for the same reason:
  // a deleted promotion loses its link, never its history.
  appliedPromotionId          String?
  appliedPromotionLabel       String?
  appliedPromotionCode        String?
  appliedPromotionKind        PromotionKind?
  createdAt                   DateTime             @default(now())

  store            Store       @relation(fields: [storeId], references: [id], onDelete: Cascade)
  product          Product?    @relation(fields: [productId], references: [id], onDelete: SetNull)
  appliedPromotion Promotion?  @relation(fields: [appliedPromotionId], references: [id], onDelete: SetNull)
  items            OrderItem[]

  @@unique([paymentProvider, externalOrderId])
  @@unique([paymentProvider, externalPaymentId])
  // "Which orders used this promotion" is a question a merchant asks about a
  // campaign, so the foreign key is indexed rather than scanned.
  @@index([appliedPromotionId])
}

// The Execution & Verification Engine's history: append-only, never updated.
// A logical request's status changing over time (e.g. an OAuth handoff going
// PENDING -> SUCCESS) is a new row sharing `executionId`, not a mutated row —
// see ARCHITECTURE.md. `action` is a plain String (not an enum) because the
// action catalog grows with every feature, unlike IntegrationProvider which
// only grows when a human deliberately writes a new connector.
//
// storeId/storeDraftId are both optional, same dual-phase pattern as
// StoreGeneration: most executions belong to a real Store, but Genesis's
// draft-side chat happens before a Store exists at all, only a StoreDraft.
model ExecutionLog {
  id            String   @id @default(cuid())
  executionId   String
  storeId       String?
  storeDraftId  String?
  action        String
  status        String // SUCCESS | WARNING | FAILED | PENDING
  verified      Boolean  @default(false)
  message       String
  retryable     Boolean  @default(false)
  actorType     String // USER | GENESIS | SYSTEM
  actorId       String?
  schemaVersion Int      @default(1)
  metadata      Json?
  createdAt     DateTime @default(now())

  store                   Store?                   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  storeDraft              StoreDraft?              @relation(fields: [storeDraftId], references: [id], onDelete: Cascade)
  actor                   User?                    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  growthPointTransactions GrowthPointTransaction[]
  storeMessages           StoreMessage[]

  @@index([storeId, createdAt])
  @@index([storeId, action])
  @@index([executionId])
}

// PH-07 Layer 3 — Genesis-generated recommendations, cached so the dashboard
// never makes an AI call during a normal page render (only an explicit
// "Refresh Genesis Suggestions" click does). No `source` column: every row
// here is by definition source: "genesis" once mapped to the shared
// Recommendation type — see lib/dashboard/recommendations.ts.
// Phase 3 Milestone 6 (J4 Cognitive Layer) — superseded as a write target.
// lib/intelligence/cognitiveLayer.ts's runCognitiveReview() (formerly
// generateGenesisRecommendations()) now writes CognitiveOutput rows
// instead. Left in place, unwritten-to going forward, rather than deleted
// or migrated — matching this codebase's "don't rewrite history" discipline
// (ExecutionLog is append-only for the same reason). Historical rows and
// this model's own shape stay exactly as they were; retiring it fully is
// separate, explicit future cleanup, not forced here.
model GeneratedRecommendation {
  id          String   @id @default(cuid())
  storeId     String
  priority    String // high | medium | low
  message     String
  actionLabel String
  actionHref  String
  generatedAt DateTime @default(now())
  // Phase 3 Milestone 5 — same shape/nullability as BusinessEvent.recordId
  // above: which specific BusinessRecord (a Goal, a Challenge, a Contact,
  // ...) this recommendation is actually about, when it's about one
  // specific entity rather than the business in aggregate. Null is the
  // honest, common case — most recommendations (today: theme/hero/SEO
  // copy) aren't about any one record. ApprovalRequest deliberately does
  // NOT duplicate this column — it already links back here via
  // recommendationId, so recordId is read by joining through, matching how
  // topicKey's own "underlying issue identity" is likewise only ever set
  // here, not copied onto every table that references a recommendation.
  recordId    String?
  entityType  String?

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId])
}

// Phase 3 Milestone 6 (J4 Cognitive Layer) — the durable, queryable record
// of everything Genesis has reasoned about the business, polymorphic across
// every real output kind (same "one generic table, JSON payload, code-level
// discrimination" convention as BusinessRecord/GenesisObservation/
// ExecutionLog/ProductEvent — never a table per kind). Produced by the
// Observe -> Explain -> Recommend stages of runCognitiveReview();
// approvalRequestId is set once the Execute stage (unchanged — the existing
// GENESIS_ACTIONS/execute()/DelegatedAuthority machinery) acts on one.
//
// relatedOutputIds is a second, deliberately SEPARATE reference space from
// BusinessRecord's own xxxId/xxxIds convention: recordId points into "what's
// true about the business" (a Goal, a Challenge, a Contact...);
// relatedOutputIds points into "what Genesis has reasoned about it" (a
// Recommendation citing the Opportunity it addresses, an Opportunity citing
// the Explanation it's grounded in). Not merged into findRelated(), which
// only ever walks BusinessRecord space — these are two distinct graphs.
model CognitiveOutput {
  id                String    @id @default(cuid())
  storeId           String
  kind              String // insight | prediction | explanation | recommendation | opportunity | briefing
  summary           String // self-contained — matches every existing "message must be self-contained" convention
  data              Json? // structured supporting detail specific to kind (e.g. an insight's own real metrics)
  priority          String? // high | medium | low — recommendation/opportunity/prediction; null for insight/explanation
  // Deliberately separate from priority: priority is business importance,
  // confidence is how certain J4 is the finding is correct given current
  // evidence — the same distinction Belief.confidence already draws
  // elsewhere in this architecture, applied here to Reason's own output for
  // the first time. Recommendation/opportunity only; null for every other
  // kind, and null for older rows written before this column existed.
  confidence        Float? // 0-1, recommendation/opportunity only
  // Real columns, not buried in `data` — matches GeneratedRecommendation's
  // own precedent, since these are directly queried/displayed (Home's
  // "From Genesis" panel), not just supporting detail. Null for kinds that
  // never carry a direct action (insight, explanation).
  actionLabel       String?
  actionHref        String?
  recordId          String? // which BusinessRecord this is about, if any — same honest-null convention as BusinessEvent.recordId
  entityType        String?
  relatedOutputIds  String[]  @default([])
  // Same stable-issue-identity concept as ApprovalRequest.topicKey, used the
  // same way: dedup/supersede across review runs for the same underlying
  // finding, honest null when no such stable identity exists.
  topicKey          String?
  proposedAction    Json? // {actionType, input} — same shape as ProposedActionSchema
  approvalRequestId String?
  status            String    @default("ACTIVE") // ACTIVE | RESOLVED | SUPERSEDED
  generatedAt       DateTime  @default(now())
  resolvedAt        DateTime?

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId, kind])
  @@index([storeId, status])
  @@index([storeId, recordId])
}

// PH-07 Layer 4 — the generic approval gate any current or future Genesis
// capability plugs into. Deliberately not recommendation-specific:
// recommendationId is a loose, optional reference (no FK — see
// ARCHITECTURE.md for why), never a required one. Only three statuses:
// approving and executing collapse into one EXECUTED state since the
// approve flow is synchronous (execute() never throws past its own
// boundary) — the actual outcome quality (SUCCESS/WARNING/PARTIAL/FAILED)
// lives on the linked ExecutionLog row via executionId, not duplicated
// here. No ExecutionLog row is written at proposal or rejection time —
// ExecutionLog represents things that were actually executed.
model ApprovalRequest {
  id                   String    @id @default(cuid())
  storeId              String
  recommendationId     String?
  // Phase 3 Milestone 6 (J4 Cognitive Layer) — parallel to
  // recommendationId above, not a replacement: set when this approval
  // originates from the Cognitive Layer's own CognitiveOutput rows instead
  // of the legacy GeneratedRecommendation model. Both stay nullable and
  // independently optional — an approval only ever has at most one set.
  cognitiveOutputId    String?
  actionType           String
  // Storefront Canvas, step 1 of 6 (2026-08-12) — which part of the
  // storefront this proposal concerns, so the Website preview can highlight
  // it while the owner decides. A key of STOREFRONT_TARGETS
  // ("hero", "hero.headline", "products", ...), validated against that
  // registry rather than free text: a target with no action behind it must
  // be unaddressable, so J4 can never point confidently at something he
  // cannot then change.
  // Null means store-wide, which is every proposal that exists today. This
  // column is inert until the registry and refine_storefront land in steps
  // 2 and 3.
  target               String?
  input                Json
  previousValues       Json
  summary              String
  // Step 2 of the surface architecture (2026-08-14) — a proposal survives
  // being argued with. Sean's requirement: "if the owner disagrees with the
  // first idea, J4 should refine the same proposal rather than treating the
  // rebuttal as a new unrelated request."
  //
  // Without this, a rebuttal produced a second, unrelated ApprovalRequest and
  // the conversation's history was lost the moment it mattered most. A
  // proposal is now a CHAIN of these rows: every revision is a real, separate,
  // auditable ApprovalRequest (so the execution, approval and verification
  // pipeline is completely unchanged), linked by a shared proposalId.
  //
  // proposalId equals the id of the chain's first row, so the identity is
  // stable and indexable without walking the chain. Null on every row written
  // before this existed, which is why it stays optional rather than defaulted.
  proposalId           String?
  revision             Int       @default(1)
  // The row this one revises. Null for a first draft. Kept alongside
  // proposalId rather than derived from it, because "what changed since the
  // last version" is a different question from "what is this proposal", and
  // answering it by sorting revisions is fragile once rows can be deleted.
  supersedesId         String?
  // Sibling creative branches (2026-08-16).
  //
  // A proposal chain answers "what is my current answer" — one pending row,
  // each revision superseding the last. Creative work needs the opposite:
  // several candidates alive at once, so the owner can say "keep the symbol
  // from the original but use the typography from option 2" and have both
  // still exist to refer to.
  //
  // So a creative lineage is several CHAINS sharing one groupId. Each chain
  // is a candidate with its own revisions, and branchOfProposalId names the
  // candidate it was derived from — null on the original. Deliberately NOT
  // reusing supersedesId, which means "replaced that revision": overloading
  // it would make the original's status ambiguous, and the no-pressure rule
  // depends on nothing being superseded unless the owner actually chooses.
  //
  // branchLabel is what "option 2" is called in conversation ("Warm
  // editorial") — the thing that makes an alternative referable rather than
  // an unrelated generation.
  branchOfProposalId   String?
  branchLabel          String?
  // How much of the storefront the owner is being asked to judge, and
  // therefore how much of it must be shown. A key of PROPOSAL_SCOPES
  // (element | section | page | site) — see lib/storefront/proposalScope.ts
  // for why this is derived from what the proposal touches rather than
  // declared by the model. Null means it predates this and is presented at
  // its historical size.
  scope                String?
  // J4's own reasoning, kept separate from `summary`. Summary says what
  // changes; this says why, and it is what the owner is actually arguing with
  // when they push back. Losing it across a revision would make "I don't like
  // that, keep the handmade feel" unanswerable.
  rationale            String?
  // Two or more visual directions offered by ONE revision (2026-08-14).
  //
  // Sean: "a single revision can contain a visual comparison when J4 is
  // asking me to choose between directions... that does not mean we need two
  // independent proposal chains."
  //
  // So directions live inside a revision rather than forking the chain. Shape:
  // [{ id, label, rationale, changes }]. Choosing one does not mutate this
  // row; it writes the NEXT revision carrying only the chosen changes, so
  // revisions stay immutable and "I like B, but warmer" is an ordinary
  // refinement of B. Null is the normal case: one revision, one direction.
  directions           Json?
  /// PENDING_APPROVAL | EXECUTING | EXECUTED | REJECTED | SUPERSEDED
  ///
  /// EXECUTING added 2026-08-23 (D4). The row read PENDING_APPROVAL for the
  /// whole duration of an external call, so two callers both passed the read
  /// and both executed — a double change and a double growth-point charge.
  /// Claiming the row makes the second lose atomically.
  status               String    @default("PENDING_APPROVAL")
  /// When this attempt claimed the row. Not a deadline: recovery reads evidence
  /// first and uses this only to avoid racing a live execution.
  claimedAt            DateTime?
  /// THE ATTEMPT'S DURABLE IDENTITY (D4). Minted before execute() runs and
  /// handed to it, so the ExecutionLog row it writes carries this exact id.
  /// That is what lets recovery ask "did THIS attempt finish" instead of
  /// guessing from elapsed time. Distinct from `executionId` below, which
  /// records the execution of a SETTLED decision.
  attemptExecutionId   String?
  authorizationTier    String    @default("always_ask") // always_ask | auto_below_limit | auto — frozen snapshot of the tier that governed this request at creation time, see lib/execution/genesisActions.ts
  groupId              String? // shared across every ApprovalRequest created from one Genesis "thought" (one chat turn, or one recommendation-review run) — Phase 4 — presentational grouping only; never merges the underlying decision or execution
  // Phase 5 — stable identity of the underlying BUSINESS ISSUE/OPPORTUNITY
  // this action addresses (same concept as GenesisObservation.dedupeKey for
  // AI-detected opportunities) — deliberately NOT an identity of this one
  // recommendation/action instance. Populated only when the proposing
  // Claude call can name a real, stable underlying issue (today: only
  // generateGenesisRecommendations.ts's review path); left null rather than
  // a fabricated/generic slug when no such identity genuinely exists (e.g.
  // most chat-driven, owner-directed requests like "make my website blue"
  // — see the Phase 5 plan for why that's an honest null, not a gap).
  topicKey             String?
  // Phase 6 — frozen snapshot of HOW this request was decided, never
  // recomputed. "human" = a real owner/employee click (approveGenesisAction/
  // rejectGenesisAction/revertApprovalRequest). "autonomous" = Genesis
  // itself decided, under a specific granted DelegatedAuthority row
  // (delegatedAuthorityId below) — never the model's own judgment about
  // whether it's allowed, only a deterministic grant lookup performed in
  // code before execution. See lib/execution/genesisAutonomy.ts.
  decisionMode         String    @default("human") // human | autonomous
  // The specific grant that authorized an autonomous decision, snapshotted
  // at decision time so "why was Genesis allowed to do this" is answerable
  // forever, even after the grant is later revoked. Null for "human" rows.
  // Loose reference (no FK), same convention as recommendationId.
  delegatedAuthorityId String?
  executionId          String?
  decidedByUserId      String?
  decidedAt            DateTime?
  // AI Cost & Usage Infrastructure — the AiUsageEvent this proposal
  // actually came from, if any. Deliberately pointing this direction
  // (request -> event), not the reverse: one review call
  // (lib/intelligence/cognitiveLayer.ts's runCognitiveReview) can produce
  // several ApprovalRequest rows from a single AiUsageEvent, so only this
  // direction is a valid many-to-one. Read (not written) when computing
  // "which recommendations get accepted" — AiUsageEvent.outcome itself is
  // reserved for the genuinely one-to-one cases (see that field's own
  // comment), never mutated from here, so a shared originating call is
  // never forced into a single accepted/rejected verdict it can't
  // honestly have. No FK, same loose-reference convention as
  // recommendationId/delegatedAuthorityId above.
  aiUsageEventId       String?
  createdAt            DateTime  @default(now())

  store                    Store                     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  postExecutionMeasurement PostExecutionMeasurement?

  @@index([storeId, status])
  @@index([attemptExecutionId])
  @@index([aiUsageEventId])
  // Every revision of one proposal, newest last. The only access pattern this
  // chain has: "show me this proposal, including how we got here."
  @@index([proposalId, revision])
}

// Phase 6 — the smallest durable representation of "the owner has authorized
// Genesis to handle this kind of decision for their business," without a
// generic policy engine. Scoped per (store, actionType) deliberately, not
// per category — a category grouping is presentation-only (see
// GENESIS_ACTIONS' category field); each action type earns trust
// individually, and a brand-new action type never silently inherits an
// existing category's grant. Revocation is immediate: every check reads
// `revokedAt IS NULL` live, at the moment of decision — no caching, no
// propagation delay, no in-flight action to interrupt (today's Executables
// are single synchronous writes).
model DelegatedAuthority {
  id              String    @id @default(cuid())
  storeId         String
  actionType      String
  grantedAt       DateTime  @default(now())
  // Always an OWNER — grantDelegatedAuthority requires
  // PERMISSIONS.AUTHORITY_MANAGE, which only OWNER holds (see
  // lib/permissions.ts). An employee cannot create, benefit from, or
  // influence a grant.
  grantedByUserId String
  revokedAt       DateTime?

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, actionType])
}

// Phase 5 — "what we observed in the business after this execution," never
// "the impact this execution had." One row per measured EXECUTED
// ApprovalRequest, computed once (deterministically, zero AI cost) when its
// fixed measurement window has elapsed, never re-evaluated. There is
// deliberately no field anywhere here for a percentage, a "lift," a
// direction label, or any other verdict — only two raw before/after counts,
// a template-generated sentence built from them, and concurrentActionTypes
// (which other Genesis actions ALSO executed inside the same before/after
// window). concurrentActionTypes exists purely to flag how confounded a
// given window is; it is never used to net out or weight anyone's
// contribution — this system does not and should not calculate attribution.
model PostExecutionMeasurement {
  id                    String   @id @default(cuid())
  approvalRequestId     String   @unique
  storeId               String
  actionType            String // denormalized from ApprovalRequest — cheap grouping without a join
  topicKey              String? // denormalized from ApprovalRequest at measurement time — see topicKey's own comment above
  scope                 String // "store" | "product"
  productId             String? // set only when scope is "product" (today: only update_product_image)
  windowDays            Int // fixed constant (see lib/dashboard/postExecutionMeasurement.ts), not owner-configurable
  orderCountBefore      Int
  orderCountAfter       Int
  revenueBeforeCents    Int?
  revenueAfterCents     Int?
  concurrentActionTypes String[] // other Genesis actionTypes EXECUTED for this store inside the same before/after window
  summary               String // deterministic, template-generated — the confounding caveat is baked into the sentence itself whenever concurrentActionTypes is non-empty, never a separate field someone could quote without it
  measuredAt            DateTime @default(now())

  store           Store           @relation(fields: [storeId], references: [id], onDelete: Cascade)
  approvalRequest ApprovalRequest @relation(fields: [approvalRequestId], references: [id], onDelete: Cascade)

  @@index([storeId, measuredAt])
}

// Phase 4 — the durable distinction between "Genesis noticed this" and a
// recommendation being recomputed every render. Keyed by a stable dedupeKey
// (a hand-written state-issue id, a real ExecutionLog/StoreIntegration row
// id, or an AI-authored topicKey) so re-detecting the same real condition
// upserts the existing row instead of spawning a duplicate or re-notifying.
// genesisState is deliberately narrow — only "opportunity" (Purple) and
// "urgent" (Red) ever get persisted here; Yellow already has real backing
// via pending ApprovalRequests and White/Blue need no persisted state at
// all. Routine incomplete-setup state (unpublished/no products/no payment)
// is never written here — that stays Business Journey's job, positively
// framed, never duplicated as an alarming Red signal.
model GenesisObservation {
  id              String    @id @default(cuid())
  storeId         String
  dedupeKey       String
  genesisState    String // opportunity | urgent
  summary         String
  actionHref      String?
  status          String    @default("ACTIVE") // ACTIVE | RESOLVED | DISMISSED
  firstNoticedAt  DateTime  @default(now())
  lastConfirmedAt DateTime  @default(now())
  resolvedAt      DateTime?
  dismissedAt     DateTime?
  // Phase 3 Milestone 5 — same shape/nullability/reasoning as
  // GeneratedRecommendation.recordId above: which specific BusinessRecord
  // this observation is about, when there is one (e.g. a specific
  // high-severity Challenge) — null for genuinely store-wide observations
  // (e.g. "no payment connected"), same honest-null convention.
  recordId        String?
  entityType      String?

  store               Store               @relation(fields: [storeId], references: [id], onDelete: Cascade)
  proactiveDeliveries ProactiveDelivery[]

  @@unique([storeId, dedupeKey])
  @@index([storeId, status])
}

/// WHAT J4 HAS ALREADY SAID OUT LOUD, and nothing else.
///
/// Proactive J4, 2026-08-23. Deliberately NOT a second representation of a
/// finding — GenesisObservation stays the only source of truth for what is true
/// about a business. This records one fact that row cannot: whether J4 has
/// spoken about this occurrence of it.
///
/// The distinction is the whole reason this table exists. A card may sit on the
/// dashboard for as long as a finding is true, and `notifyFromInsights`
/// deliberately keeps re-confirming it — suppressing a still-true finding would
/// silently retract it. A SENTENCE cannot work that way: saying the same thing
/// every cycle is how a partner becomes a feed.
///
/// RE-ENGAGEMENT, and why it needs `closedAt` rather than a plain unique key.
/// upsertObservation reuses the same row when a finding resolves and later
/// recurs, so the observation id is stable across occurrences. Keyed on the id
/// alone, a finding that came back months later could never be mentioned again.
/// Instead a delivery is CLOSED when its finding stops being active, and the
/// partial unique index below allows exactly one OPEN delivery per finding —
/// so J4 speaks once per occurrence, enforced by the database rather than by
/// remembering to check.
///
/// Closing a delivery never touches the message. What J4 said stays said: a
/// finding disappearing later does not un-say it.
model ProactiveDelivery {
  id             String    @id @default(cuid())
  storeId        String
  observationId  String
  /// The message the owner actually saw. Kept even after this delivery closes.
  storeMessageId String
  spokenAt       DateTime  @default(now())
  /// Set when the finding stopped being active. Null means J4 has spoken about
  /// this occurrence and has not been released to speak about it again.
  closedAt       DateTime?

  store        Store              @relation(fields: [storeId], references: [id], onDelete: Cascade)
  observation  GenesisObservation @relation(fields: [observationId], references: [id], onDelete: Cascade)
  storeMessage StoreMessage       @relation(fields: [storeMessageId], references: [id], onDelete: Cascade)

  @@index([storeId, closedAt])
  @@index([storeMessageId])
}

// J4 Noticed dismiss/exit (2026-08-08) — "dismissal must NOT mean
// resolution... the underlying observation/problem/decision remains
// persisted and available to J4" (Sean). Deliberately NOT reusing
// GenesisObservation's own existing (real but never wired up) `status:
// "DISMISSED"`/`dismissedAt` fields — those would only ever cover one of
// five real card kinds (proposal/issue/discovery/task/observation), and
// Sean's own explicit requirement is one uniform rule for all of them,
// not a different mechanism per kind. This table only ever affects
// whether a card renders in the Noticed presentation (see
// lib/dashboard/attentionCards.ts's own filtering) — it never touches
// ApprovalRequest/GenesisObservation/Task/AttentionItem's real status,
// so every other reader of those (including J4's own chat/business-
// understanding queries) sees them completely unaffected.
// cardId is the same real, already-existing AttentionCard.id string
// (e.g. "observation:xyz", "proposal:abc") — no new per-source-type
// modeling needed, one generic mechanism works uniformly across all five
// kinds because they already share one canonical id scheme.
model DismissedAttentionCard {
  id                String   @id @default(cuid())
  storeId           String
  cardId            String
  dismissedAt       DateTime @default(now())
  dismissedByUserId String?

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, cardId])
  @@index([storeId, dismissedAt])
}

// BUSINESS_ASSETS_ARCHITECTURE.md M1 — the unified representation of "one
// real thing for the owner (or J4) to do," additive alongside
// AttentionItem/GenesisObservation/NextBestAction rather than replacing
// their own detection queries, which keep running unchanged. This is the
// dual-write target those sources upsert into (see lib/dashboard/tasks.ts),
// proving the model on real data before any rendering path fully cuts over
// to it. Same upsert-by-dedupeKey identity pattern as GenesisObservation —
// re-detecting the same real condition refreshes this row in place rather
// than creating a duplicate.
model Task {
  id        String @id @default(cuid())
  storeId   String
  dedupeKey String

  // Source — provenance, never identity. Mirrors GenesisObservation's own
  // recordId/entityType nullable-pair convention below.
  source            String // "state_issue" | "brand_gap" | "observation" | "next_best_action" | "manual" | "chat"
  sourceId          String?
  relatedRecordId   String?
  relatedEntityType String?
  relatedAssetId    String? // BusinessRecord (entityType: "asset") this task references, when there is one

  title   String
  summary String
  context Json // structured "why this exists" snapshot, not a restatement

  // Action — how this connects to the real execution engine, when it does.
  // Deliberately nullable: a task can exist with no automatable action yet.
  actionType    String?
  trustLevel    String  @default("recommend") // "inform" | "recommend" | "prepare" | "auto_execute" | "always_approve"
  requiredInput Json?
  actionHref    String? // plain navigation fallback, same mechanism every other card in this codebase already uses
  // BUSINESS_ASSETS_ARCHITECTURE.md M3 — real infrastructure for the
  // Prepare workflow (multi-turn drafting held across turns before a final
  // commit decision), not yet populated by anything in M3 itself. Added now
  // so the field exists ahead of the dedicated implementation pass that
  // actually builds the drafting loop, rather than another migration later.
  draftState    Json?

  priority String // "FAILED" | "WARNING" | "opportunity" — reuses AttentionItem's existing severity vocabulary
  status   String @default("OPEN") // OPEN | IN_PROGRESS | AWAITING_INPUT | COMPLETED | DISMISSED

  // Conversation — set once a card is clicked and a real seeded turn exists
  // (M2 — StoreMessage.taskId doesn't exist yet, so this stays unset today).
  seedMessageId String?

  completedAt DateTime?
  dismissedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  store         Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  messages      StoreMessage[]
  conversations Conversation[]

  @@unique([storeId, dedupeKey])
  @@index([storeId, status])
}

// Family-beta behavioral/friction instrumentation (v20). One generic,
// append-only event table — deliberately not several bespoke tables — for
// everything the existing audit/business models (ExecutionLog, StoreMessage,
// ApprovalRequest, GenesisObservation) don't already capture: navigation,
// focus-routing outcomes, chat turn latency, perceived-loading duration, and
// the pre-launch creation ("Welcome to Genesis") journey. `name` is a plain,
// freely-growing String catalog (see EXECUTION_ACTIONS's own reasoning),
// never an enum. `attemptKey` is the correlation seam for reconstructing an
// attempt sequence (entered -> problem -> attempt 1 -> attempt 2 -> recovered
// or abandoned) — always a real, already-meaningful identity already used
// elsewhere (topicKey, groupId, dedupeKey, a storeDraftId, a fixed flow name)
// rather than an invented counter. `metadata` only ever holds small,
// allow-listed structured fields and *references* to other rows' own ids —
// never raw chat/form content, which stays in its own real row and is joined
// at reconstruction time.
model ProductEvent {
  id                String   @id @default(cuid())
  userId            String?
  storeId           String?
  // Deliberately NOT a real relation (unlike storeId/userId below) — a
  // StoreDraft is deleted as the normal, successful terminal step of the
  // creation journey (confirmStoreDraft), not an edge case, and the
  // "creation.confirmed" event is written *after* that delete. A hard FK
  // here would either cascade-delete the very creation.* history this
  // table exists to preserve, or reject the terminal event's own insert —
  // same "no FK, might legitimately outlive its referent" reasoning
  // ApprovalRequest.recommendationId already uses.
  storeDraftId      String?
  sessionInstanceId String
  name              String
  category          String // navigation | chat | approval | integration | creation | performance | journey
  attemptKey        String?
  outcome           String? // success | failure | abandoned | null (in progress / not applicable)
  durationMs        Int?
  metadata          Json?
  createdAt         DateTime @default(now())

  user  User?  @relation(fields: [userId], references: [id], onDelete: Cascade)
  store Store? @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([sessionInstanceId, createdAt])
  @@index([attemptKey])
  @@index([storeId, createdAt])
}

// Phase 3 Milestone 1 (J4 Foundation) — J4's canonical, provider-agnostic
// understanding of "a business." One generic table for every entity type
// (contact/transaction/item/appointment/campaign/... — see
// lib/businessModel/entities.ts's registry), same shape philosophy as
// StoreIntegration/GenesisObservation/ProductEvent: entityType and
// sourceProvider are plain Strings, not enums, so a new entity type or a new
// connector never needs a migration. `data`'s shape is validated against
// entities.ts's Zod schema for entityType at write time, not enforced here.
// Cross-entity relationships were once ONLY a naming convention: a field in
// `data` named `xxxId`/`xxxIds` held another BusinessRecord.id, and
// findRelated scanned every record of every type looking for one. That still
// works and still runs, but it could not say WHAT a relationship was, and it
// could not be asked a question without loading the world. RecordRelationship
// (below) is the canonical, typed, indexed representation; the convention is
// its input, not its replacement. See lib/businessModel/relationships.ts.
//
// sourceProvider "internal" (the live store's own Order/Product data) is
// reserved but never actually written here — lib/businessModel/
// internalMapper.ts computes those records live on every read instead of
// persisting a synced copy, since that data is already live in Postgres.
// This table is created now so a real external connector (Phase 3
// Milestone 2) needs zero schema change of its own, only population.
model BusinessRecord {
  id             String   @id @default(cuid())
  storeId        String
  entityType     String
  sourceProvider String
  externalId     String
  data           Json
  syncedAt       DateTime @default(now())

  /// WHERE THIS FACT CAME FROM (2026-08-22).
  ///
  /// sourceProvider already named the pipe it arrived through -- "quickbooks",
  /// "genesis_chat", "genesis_upload". What it could not say is what KIND of
  /// source that is, and those are not the same question: a figure QuickBooks
  /// published, a figure the owner stated, and a figure a model concluded from
  /// a photograph are three different grades of evidence arriving through three
  /// pipes whose names happen to differ. Reasoning that treats them alike is
  /// reasoning that presents a guess with the authority of a bank statement.
  ///
  /// NULL means nobody recorded it, which is every row written before this
  /// column existed. That is an honest unknown and is deliberately NOT
  /// backfilled to a plausible value -- see the migration for why guessing
  /// here would defeat the entire point of the column.
  provenance RecordProvenance?

  /// The concrete source within that kind: the connector's own name, or the
  /// Asset BusinessRecord.id a document fact was read out of. Free text
  /// because the shape genuinely varies; never parsed for meaning.
  provenanceDetail String?

  /// When the SOURCE asserted it -- distinct from syncedAt, which is when this
  /// row was last written. "The owner told us in March" and "we wrote this row
  /// this morning" are different facts, and only the first one answers whether
  /// a claim about the business is still current.
  statedAt DateTime?

  /// The User who stated it, when a person did. Null for connector and derived
  /// facts, which have no author.
  statedById String?

  /// Whether a model stood between the source and this record.
  ///
  /// A goal the owner typed and a goal a model distilled from a rambling voice
  /// memo are both OWNER-provenance -- the owner is the author either way --
  /// but only one of them is the owner's own words. NULLABLE, not defaulted to
  /// false: a historical row does not get to claim nothing interpreted it.
  modelExtracted Boolean?

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, entityType, sourceProvider, externalId])
  @@index([storeId, entityType])
}

/// WHAT KIND OF SOURCE STATED A FACT (2026-08-22).
///
/// Every value exists because a real write site in this codebase produces it AND
/// because reasoning should treat it differently. None was added for symmetry.
enum RecordProvenance {
  /// A connected system's own API said so -- QuickBooks, Mailchimp, Google
  /// Calendar, Instagram. First-party to that system, and as current as its
  /// last sync (StoreIntegration.lastSyncedAt, already tracked).
  CONNECTOR

  /// The owner stated it -- in chat, in a meeting, in a form. First-party and
  /// authoritative about intent in a way nothing else is: only the owner knows
  /// what the owner is trying to do. Goes stale by being superseded, never by
  /// a sync cadence.
  OWNER

  /// Read out of a record the owner provided -- an uploaded invoice, a lease,
  /// a supplier's PDF. The DOCUMENT is first-party evidence; the reading of it
  /// is a model's, which is why modelExtracted is almost always true here and
  /// why extractors in this codebase carry the source sentence alongside the
  /// value (see CommitmentSchema.sourceQuote).
  DOCUMENT

  /// Computed deterministically from data this platform already owns -- orders,
  /// products, payments. Not an inference and not a guess: arithmetic over
  /// first-party rows, exactly as trustworthy as the rows underneath it.
  /// lib/businessModel/internalMapper.ts is the whole of it today.
  DERIVED

  /// J4 concluded it. A real and useful kind of knowledge with no external
  /// referent: nothing outside this system asserted it, so it could be wrong in
  /// a way a bank statement cannot. Never to be presented, weighed, or spoken
  /// about as though somebody had said it.
  INFERENCE

  /// J4 MADE IT -- an image, a design, a drafted campaign.
  ///
  /// Shares INFERENCE's lack of an external referent and is otherwise its
  /// opposite, which is why collapsing the two was wrong. An inference is a
  /// CLAIM ABOUT THE BUSINESS and might not be true. A generated logo is a FILE
  /// THAT EXISTS; hedging it would be as dishonest as asserting the inference.
  /// The distinction was found while wiring the write sites: three of them
  /// produce artifacts, and the owner-facing label for INFERENCE ("Something I
  /// concluded") would have been a plain lie printed next to somebody's logo.
  GENERATED
}

/// A TYPED RELATIONSHIP BETWEEN TWO CANONICAL RECORDS (2026-08-22).
///
/// The convention this replaces could express THAT two records were connected
/// and never WHAT the connection was. A challenge listing a goal's id in
/// `relatedGoalIds` might block it, fund it, or merely mention it, and the only
/// way to find out was to already know. So the most useful thing J4 could say
/// about a business -- "this is what is standing between you and that" -- was
/// the one thing the model could not represent.
///
/// Indexed from BOTH ends, which is the other half of the point: findRelated
/// answered "what references this?" by loading every record of every entity
/// type into memory and scanning its keys. Correct, and O(everything).
///
/// NOT a replacement for the id fields inside `data`. Those remain the source
/// of truth for the records that carry them and are projected into this table;
/// a relationship here that contradicts the record it came from is a bug in the
/// projection, not a second opinion.
model RecordRelationship {
  id      String @id @default(cuid())
  storeId String

  /// Both ends are BusinessRecord ids, including the synthetic ids the internal
  /// mapper computes for orders and products (internal:order:<id> and friends).
  /// Not a Prisma relation for exactly that reason: half the records this can
  /// legitimately point at are computed live and have no row to constrain to.
  fromId   String
  fromType String
  toId     String
  toType   String

  /// A key from RELATIONSHIP_KINDS in lib/businessModel/relationships.ts. A
  /// String rather than an enum for the same reason entityType is: a new kind
  /// of connection should not need a migration. The closed vocabulary is
  /// enforced at write time and cross-checked by a suite.
  kind String

  /// Same envelope as BusinessRecord's, and for the same reason: a link the
  /// owner drew by hand and a link a model proposed are not equally certain,
  /// and a reader that cannot tell them apart will present both as fact.
  provenance       RecordProvenance?
  provenanceDetail String?
  statedAt         DateTime?
  statedById       String?

  /// WHICH RECORD'S DATA MAINTAINS THIS EDGE, so a projection can take it back.
  ///
  /// Provenance says who STATED a link; this says what MAINTAINS it, and they
  /// are different questions. An edge projected from a challenge's
  /// relatedGoalIds and one an owner drew by hand are both OWNER, both `blocks`,
  /// and only one of them should vanish when the challenge stops naming that
  /// goal.
  ///
  /// Names the record rather than being a boolean, because the `reversed`
  /// projections store the edge pointing the other way: a goal listing its
  /// challenges produces a challenge -> goal edge, so neither endpoint
  /// identifies who is responsible for it.
  ///
  /// NULL means somebody stated it deliberately. A sync never touches those.
  projectedFrom String?

  createdAt DateTime @default(now())

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  /// One link of one kind between two records. Re-projecting is an upsert, so
  /// a re-sync never duplicates and a removed reference is reconciled away.
  @@unique([storeId, fromId, kind, toId])
  @@index([storeId, fromId])
  @@index([storeId, toId])
  @@index([storeId, projectedFrom])
}

// Phase 3 Milestone 3 (Business Intelligence Engine) — the standardized,
// provider-independent event Change Detection produces (lib/intelligence/
// changeDetection.ts) whenever a BusinessRecord meaningfully changes, or a
// time-based condition becomes true (e.g. an invoice crossing its due
// date with no new sync data at all). Deliberately carries no
// severity/importance of its own — that judgment belongs to the Insight
// Engine downstream (lib/intelligence/insights.ts); this table only ever
// records facts. Append-only, no dedup at this layer — dedup/auto-resolve
// already exists one layer further down, on GenesisObservation.
model BusinessEvent {
  id             String    @id @default(cuid())
  storeId        String
  entityType     String
  eventType      String // "contact.created" | "invoice.paid" | "invoice.overdue" | "appointment.cancelled" | ...
  recordId       String? // the BusinessRecord.id this is about — null for store-level aggregate events
  sourceProvider String
  summary        String
  data           Json?
  occurredAt     DateTime  @default(now())
  processedAt    DateTime? // set once the Insight Engine has considered it — null means new/unprocessed
  // Phase 1 (Business Event Pipeline) — a strictly-increasing, gap-tolerant
  // per-database sequence, distinct from occurredAt: two events created in
  // the same batch or millisecond are still totally ordered, which a
  // per-consumer cursor (BusinessEventCursor below) needs to resume from
  // exactly where it left off without re-processing or skipping. Existing
  // rows get a Postgres-assigned default on migration — see PHASE1_DESIGN.md
  // section 7, item 3 for why their relative order among themselves doesn't
  // matter in practice.
  sequence       BigInt    @default(autoincrement())

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId, occurredAt])
  @@index([storeId, processedAt])
  @@index([storeId, sequence])
}

// Phase 1 (Business Event Pipeline) — one row per (storeId, consumerName),
// tracking that consumer's own independent progress through the
// BusinessEvent log via `sequence`. Multiple consumers (the Insight Engine,
// a future Genesis interpreter, a future J4 write-action trigger) each walk
// the same append-only log at their own pace with no shared state, so none
// can starve or race another — see PHASE1_DESIGN.md section 6.
model BusinessEventCursor {
  id                    String   @id @default(cuid())
  storeId               String
  consumerName          String
  lastProcessedSequence BigInt   @default(0)
  updatedAt             DateTime @updatedAt

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, consumerName])
}

// J4 Foundation Phase 2 — the Learn cognitive subsystem's durable store.
// Deliberately distinct in kind from every other model in this file:
// BusinessRecord/BusinessEvent/CognitiveOutput all hold verified,
// first-order fact or Reason's own point-in-time conclusions; a Belief
// holds an INFERRED, REVISABLE generalization drawn from many of those over
// time, and must never be merged into or confused with either — see the
// Learn subsystem specification (memory: project_j4_cognitive_architecture.md)
// for the full "fact vs. belief" epistemic boundary this table exists to
// keep honest.
//
// No stored "maturity stage" (Observation/Hypothesis/Established Belief/...)
// — deliberately. Maturity is a DERIVED read computed from evidenceCount/
// firstObservedAt/lastContradictedAt/confidence at the moment something
// needs a human-readable label, never an independently authored or
// transitioned piece of state — this keeps the schema honest, with nothing
// here representing a category boundary someone had to judge.
model Belief {
  id       String @id @default(cuid())
  storeId  String
  // Same stable-identity concept ApprovalRequest.topicKey/CognitiveOutput.
  // topicKey already use — the underlying pattern this belief is about,
  // independent of exact wording, so new evidence updates the SAME belief
  // instead of spawning a duplicate every time it's re-confirmed.
  topicKey String
  claim    String // a real, self-contained sentence Reason can use directly
  category String // open vocabulary: "insight_recurrence" | "outcome_pattern" | "owner_preference" | "event_recurrence" | ...

  confidence    Float // 0-1 — current strength of evidential support, see computeConfidence in lib/intelligence/learn.ts
  evidenceCount Int // breadth — how many independent instances support this, distinct from confidence on purpose

  firstObservedAt    DateTime // when the earliest contributing evidence occurred, not when this row was created
  lastConfirmedAt    DateTime // most recent evidence that supported (or didn't contradict) this belief
  lastContradictedAt DateTime? // most recent evidence that went AGAINST it — comparing this to lastConfirmedAt is what detects Reconsideration (a long-stable belief suddenly facing contradiction)

  // Real, inspectable grounding — ExecutionLog/CognitiveOutput/BusinessEvent/
  // PostExecutionMeasurement ids that contributed, plus the actual computed
  // numbers behind the claim. A belief with nothing here is not allowed to
  // exist, per Learn's own traceability invariant.
  evidenceRefs String[] @default([])
  data         Json?

  recordId   String? // same honest-null convention as CognitiveOutput/BusinessEvent — set only when genuinely about one specific record
  entityType String?

  status        String    @default("ACTIVE") // ACTIVE | RETIRED
  retiredAt     DateTime?
  retiredReason String? // plain text, not a rigid enum — "absorbed into a more general belief" | "did not generalize" | "contradicted by new evidence"

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, topicKey])
  @@index([storeId, status])
}

// Track 0 (Operational Foundations) — AI cost governance. An emergency
// circuit breaker, not a billing/metering system: real per-call token
// usage (from the Anthropic response's own usage.input_tokens/
// output_tokens, never estimated) recorded as an append-only log rather
// than a single running counter, specifically so enforcement (currently a
// daily sum) can evolve into rolling windows, analytics, or customer usage
// reports later without changing this model — only the query logic that
// reads it. See lib/genesisModel.ts for the actual enforcement.
//
// storeId/userId are both nullable, exactly one is ever set — not every
// AI call has a real Store yet. Store-draft generation and draft-phase
// chat (generateStoreDraftCore/applyGenesisMessage in ai-actions.ts) run
// before a Store row exists, with only a userId available; every other
// call site has a real storeId. Each identifier gets its own independent
// daily ceiling bucket — a real, accepted simplification for a Track 0
// item, not a unified per-owner total across the draft-to-live boundary.
//
// AI Cost & Usage Infrastructure — this model's scope grew from "usage
// governance" to "the canonical AI action ledger" (2026-08-04). Every new
// column below is nullable so every existing row, and every existing
// reader (getTodayTokenUsage's ceiling check, byte-for-byte unchanged),
// keeps working exactly as before. See lib/aiFeatures.ts/lib/aiPricing.ts
// for what populates feature/provider/model/costUsd going forward.
model AiUsageEvent {
  id                    String   @id @default(cuid())
  storeId               String?
  userId                String?
  // Experience-First Onboarding — the anonymous-scope counterpart to
  // storeId/userId above. No relation (an anonymous session is never a real
  // row anywhere), same "exactly one of these three is ever set" convention
  // — see GenesisModelScope in lib/genesisModel.ts.
  anonymousSessionToken String?
  inputTokens           Int
  outputTokens          Int
  // What triggered this call — one of lib/aiFeatures.ts's AiFeature
  // catalog. Nullable only because it predates this column; every new
  // write from Milestone 2 onward sets it (a required param at the
  // call-site level, not just a schema nicety).
  feature               String?
  // "anthropic" | "openai" today; the provider that actually served the
  // request, not which SDK/helper was used internally.
  provider              String?
  // The literal model string sent to the provider (e.g.
  // "claude-opus-4-8", "gpt-image-1") — not a version-agnostic label, so a
  // future model swap is visible in the data, not silently blended in.
  model                 String?
  // Locked in at record-time from lib/aiPricing.ts's rate table in effect
  // when this call happened — never recomputed later, so editing pricing
  // going forward can't silently rewrite historical cost data. Decimal,
  // not Float, for the same reason Product.priceInCents avoids float
  // rounding — though this is a real dollar amount, not integer cents,
  // since per-call costs are routinely sub-cent.
  costUsd               Decimal? @db.Decimal(10, 6)
  // Real image count for a provider that has no token concept (OpenAI
  // image generation) — 0, not null, once a row is written for one, so
  // "0 images" and "not an image call" stay distinguishable from "unknown."
  imageCount            Int?
  durationMs            Int?
  // "accepted" | "rejected" | null. Deliberately reserved for the
  // genuinely one-to-one case — claimExperienceDraft in
  // app/onboarding/actions.ts, the only real "was this call's real-world
  // output ultimately kept" signal that always maps cleanly to one
  // originating event. NOT written from ApprovalRequest's own
  // accept/reject flow — one review call can produce several
  // ApprovalRequest rows (lib/intelligence/cognitiveLayer.ts), so forcing
  // a single verdict here would misrepresent a genuinely one-to-many
  // relationship; see ApprovalRequest.aiUsageEventId instead, read (not
  // written) to answer "which recommendations get accepted" via a join.
  // See claimExperienceDraft in
  // app/onboarding/actions.ts for the only two places this gets written.
  // Null means "no decision point exists for this call yet," not
  // "ignored" — there is no eager "ignored" write; see this model's
  // design note in the AI Cost & Usage Infrastructure plan for why.
  outcome               String?
  // The business-intent category this action serves — see
  // lib/businessIntent.ts's fixed 9-category list (Build Business, Create
  // Product, Improve Store, Create Marketing, Analyze Business, Research,
  // Financial Insight, Customer Communication, Growth Recommendation).
  // Derived automatically from `feature` (one feature always maps to
  // exactly one category) and locked in at record-time, same reasoning as
  // costUsd — a future recategorization of a feature must never silently
  // rewrite what a historical event is understood to have been. This is
  // what makes the ledger answer "how do businesses grow inside Genesis,"
  // not just "what did this cost."
  businessIntent        String?
  // Deliberately NOT derived from costUsd, and deliberately NOT named
  // "cost" — Sean's explicit product principle (2026-08-04): operational
  // cost (what a call actually costs a provider) and business value (how
  // many Growth Credits an action SHOULD require) are two independent
  // numbers. If image generation gets cheaper next year, that must never
  // silently change what an owner pays in Growth Credits for a product —
  // the customer experience shouldn't move every time a provider's
  // pricing does. Looked up from lib/growthCreditCatalog.ts (keyed by
  // `feature`, currently empty — no real values assigned yet, Growth
  // Credits aren't live) and locked in at record-time for the same
  // "never silently rewrite history" reason as businessIntent above.
  // Inert today — every row is null until the catalog has real entries.
  growthCreditValue     Int?
  // Populated only where a real session identity already exists today —
  // concretely, anonymousSessionToken copied in directly by the
  // onboarding flow. Left null everywhere else rather than inventing a
  // conversation/thread id that doesn't exist anywhere in this schema yet.
  sessionId             String?
  occurredAt            DateTime @default(now())

  store Store? @relation(fields: [storeId], references: [id], onDelete: Cascade)
  user  User?  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([storeId, occurredAt])
  @@index([userId, occurredAt])
  @@index([anonymousSessionToken, occurredAt])
  @@index([feature, occurredAt])
}

// Growth Points Economy (Chapter 2, VISION.md). A real, structural billing
// tier: what a store's monthly Growth Point allowance is, and (later) what
// a referral is worth on that tier. Deliberately shipped with zero real
// rows — assigning real allowances is Sean's own product-strategy decision
// for a dedicated design session, not something to invent during
// implementation (same discipline as lib/growthCreditCatalog.ts). Global,
// not tenant-scoped — a Plan is platform config, not a store's own data.
model Plan {
  id                          String   @id @default(cuid())
  name                        String   @unique
  // Null until a real plan design exists — the monthly refresh sweep
  // (lib/growthPoints/refresh.ts) honestly no-ops for a store on a plan
  // whose allowance isn't set yet, rather than crediting zero and calling
  // it done.
  monthlyGrowthPointAllowance Int?
  // Null until Sean sets it — see Referral below for the same "wired but
  // inert" reasoning as growthCreditCatalog.ts.
  referralRewardPoints        Int?
  // Chapter 5 (Payments) — the real Stripe recurring Price this plan
  // subscribes an owner to. Null until Sean creates a real Plan row with a
  // real price — same "ships empty, populated later, never guessed"
  // discipline as the two fields above.
  stripePriceId               String?  @unique
  // Growth Points Economy — real initial pricing, frozen 2026-08-05.
  // Display only: the real charge always comes from Stripe's own Price
  // object (stripePriceId) at checkout time, this is a cached snapshot so
  // the billing/growth-points pages can show a real "$X/month" without an
  // extra Stripe API round-trip on every page load.
  priceInCents                Int?
  // Null means no plan-level free tier (Builder, Growth). A real number
  // means any GENESIS_ACTIONS entry whose lib/growthPoints/catalog.ts cost
  // is at or below this ceiling never touches the store's own balance —
  // Business Partner's own "unlimited 1-point actions" (see
  // lib/growthPoints/ledger.ts's checkGrowthPointBalance/
  // deductGrowthPoints). Deliberately a ceiling, not a boolean or a fixed
  // "1" — generalizes to a future plan wanting its own real threshold.
  unlimitedActionCostCeiling  Int?
  // The one-time bonus granted on a store's real first-ever subscription
  // to this plan (lib/growthPoints/ledger.ts's creditOnboardingAllocation,
  // triggered from the platform billing webhook). Null until Sean sets a
  // real number — same "wired but inert" discipline as every other
  // deferred value in this economy; the mechanism is real, this amount
  // just isn't decided yet.
  onboardingAllocation        Int?
  createdAt                   DateTime @default(now())
  updatedAt                   DateTime @updatedAt

  stores Store[]
}

// The append-only ledger behind Store.growthPointBalance — every balance
// change (DEDUCTION on an approved execution, REFRESH on the monthly
// grant, REFERRAL_REWARD, future PURCHASE once Chapter 5 wires a real
// payment rail, or a manual ADJUSTMENT) writes exactly one row here,
// mirroring ExecutionLog's own append-only convention. A separate model
// from ExecutionLog rather than nested under it — REFRESH/REFERRAL_REWARD
// entries have no execution to attach to, so ExecutionLog alone can't
// honestly represent this ledger. executionLogId is nullable and only set
// on DEDUCTION rows, for traceability back to the real execution that
// spent the points.
model GrowthPointTransaction {
  id             String   @id @default(cuid())
  storeId        String
  // DEDUCTION | REFRESH | REFERRAL_REWARD | PURCHASE | ADJUSTMENT — a plain
  // String, not a Prisma enum, matching ExecutionLog.status/actorType's own
  // "avoid enum-migration friction" convention in this schema.
  type           String
  // Signed — negative for DEDUCTION, positive for every credit type.
  amount         Int
  // The real balance immediately after this transaction, so history can be
  // read back without replaying every prior row.
  balanceAfter   Int
  // Set only on DEDUCTION rows — the GENESIS_ACTIONS actionType this
  // transaction paid for (lib/execution/genesisActions.ts's keys, the same
  // vocabulary lib/growthPoints/catalog.ts is keyed by).
  actionType     String?
  executionLogId String?
  description    String
  // Chapter 5 (Payments) — the idempotency key for a real PURCHASE row: the
  // originating Stripe object id (a Checkout Session id today). Guards
  // against double-crediting on a redelivered webhook event, mirroring
  // Order's own @@unique([paymentProvider, externalOrderId]) pattern —
  // there's no Order row to piggyback that guard on here, so this is its
  // own unique constraint instead. Null for every non-PURCHASE type.
  externalRef    String?  @unique
  createdAt      DateTime @default(now())

  store        Store         @relation(fields: [storeId], references: [id], onDelete: Cascade)
  executionLog ExecutionLog? @relation(fields: [executionLogId], references: [id], onDelete: SetNull)

  @@index([storeId, createdAt])
}

// A real shareable referral relationship: referrerUserId invited
// referredUserId via `code`. Reward fires on a real completion signal
// (Store.firstMeetingCompletedAt being set on the referred store — the
// same "onboarding genuinely finished" signal Meeting with J4 already
// established), not bare signup, to avoid trivially-gamed rewards. Reward
// amount comes from Plan.referralRewardPoints, which is null (honest
// no-op) until Sean sets it.
model Referral {
  id             String    @id @default(cuid())
  referrerUserId String
  referredUserId String    @unique
  code           String    @unique
  // PENDING | REWARDED — flips once, never reverts; the reward grant is
  // guarded to be idempotent against this status, not against re-running
  // the sweep that checks it.
  status         String    @default("PENDING")
  rewardedAt     DateTime?
  createdAt      DateTime  @default(now())

  referrer User @relation("ReferralsSent", fields: [referrerUserId], references: [id], onDelete: Cascade)
  referred User @relation("ReferralsReceived", fields: [referredUserId], references: [id], onDelete: Cascade)

  @@index([referrerUserId])
}

// Business Partner Preview — the real, append-only record of every 7-day
// trial ever granted (see lib/growthPoints/trial.ts). Deliberately NOT
// keyed to Store via a real Prisma relation with onDelete: storeId is a
// plain string snapshot, not a foreign key, so deleting a store can never
// erase that its trial was granted. This survival is what makes both the
// "only one active trial per account at a time" guard and any future
// per-account fraud review stay correct even after a farmed store is
// deleted — Sean's own explicit requirement. Store.businessPartnerTrialEndsAt
// is the fast, live "is a trial active right now" check; this table is the
// durable history behind it.
model BusinessPartnerTrialGrant {
  id        String   @id @default(cuid())
  userId    String
  storeId   String
  storeName String
  grantedAt DateTime @default(now())
  expiresAt DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// PROMOTIONS (2026-08-26) — the merchant's own offers, in Genesis rather than
// in a payment provider.
//
// Deliberately NOT Stripe Coupon objects. Stripe's own promotion API would have
// shown a strikethrough on Stripe's hosted page and done absolutely nothing on
// the PayPal rail, which takes a single pre-formatted dollar string and has no
// discount concept at all. A promotion that silently fails on one of two rails
// is worse than no promotion. So the discount is applied to the amount BEFORE
// it reaches either provider, by lib/pricing/orderPricing.ts, and both rails
// charge the same arithmetic.
model Promotion {
  id      String @id @default(cuid())
  storeId String
  // What the customer sees on the breakdown: "Spring Sale", or the code.
  name    String

  kind PromotionKind

  // Null for a SALE. For a CODE this is what the customer types, stored
  // UPPERCASE and trimmed so "save10", "SAVE10" and " Save10 " are one code
  // rather than three — a customer copying a code out of an email should not
  // fail on whitespace.
  code String?

  discountType     DiscountType
  // Exactly one of these is set, enforced by a CHECK constraint in the
  // migration rather than by hope: a PERCENTAGE with no percentage is not a
  // generous promotion, it is a broken one, and orderPricing treats it as zero.
  percentOff       Int?
  amountOffInCents Int?

  scope PromotionScope

  // The merchant's on/off switch, independent of dates. A promotion can be
  // inactive inside its window (paused) or active outside it (scheduled), and
  // both are real states — eligibility needs BOTH to pass.
  active Boolean @default(true)

  // Optional on purpose. A sale with no dates runs until switched off, which is
  // the common case and should not require inventing a far-future date.
  startsAt DateTime?
  endsAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  store    Store              @relation(fields: [storeId], references: [id], onDelete: Cascade)
  // Empty for ALL_PRODUCTS. Populated only for SELECTED_PRODUCTS.
  products PromotionProduct[]
  // Orders that used it. SetNull, never Cascade — deleting a promotion must
  // never delete or blank the history of what people actually paid.
  orders   Order[]

  // One code per store, so two campaigns cannot both answer to SAVE10.
  // Nullable codes do not collide in Postgres, so every SALE is exempt from
  // this without needing a partial index.
  @@unique([storeId, code])
  @@index([storeId, active])
}

enum PromotionKind {
  // Applies by itself to every eligible product. Nobody types anything.
  SALE
  // Applies only when the customer enters it at checkout.
  CODE
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

enum PromotionScope {
  ALL_PRODUCTS
  SELECTED_PRODUCTS
}

// Which products a SELECTED_PRODUCTS promotion covers.
//
// A join table rather than a String[] of ids because these are real foreign
// keys: a deleted product must leave the promotion, not leave a dangling id
// that later reads as "this promotion covers a product that no longer exists".
model PromotionProduct {
  promotionId String
  productId   String

  promotion Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([promotionId, productId])
  @@index([productId])
}

// WHAT ONE CUSTOMER WAS QUOTED, AT ONE MOMENT (2026-08-26).
//
// NOT A CART. Browsing writes nothing at all — a bag is a cookie of product ids
// and quantities, for anonymous visitors and signed-in ones alike. This row
// appears only when somebody clicks Continue to payment, and it exists for one
// reason: neither payment provider can carry a bag back to us.
//
//   PayPal gives us ONE 127-character custom_id. storeId and productId alone
//   already spend 51 of it. Four products would not fit.
//   Stripe's metadata is roomier but caps a bag at an arbitrary size and does
//   nothing for the other rail.
//
// So both rails carry this row's id instead, and the shape is identical for
// both — the same fix that made pricing one function rather than two.
//
// IMMUTABLE ONCE PAYMENT STARTS. The lines and totals here are the contract:
// what the customer agreed to and what the provider charged. A merchant editing
// a price, or a promotion expiring, while somebody is on PayPal must not change
// what the order records afterwards, because the money has already moved at the
// figure frozen here.
//
// AND IT IS NOT THE ONLY RECORD. Both providers also receive real line items —
// PayPal's purchase_units[].items[], Stripe's line_items — so a lost or expired
// draft can still be recovered from the provider's own account of what it
// charged. See Order.lineItemSource for the three tiers.
model CheckoutDraft {
  id      String @id @default(cuid())
  storeId String

  status CheckoutDraftStatus @default(OPEN)

  // The resolved bag, frozen. Shape: [{ productId, name, unitPriceInCents,
  // quantity, listInCents, discountInCents, subtotalInCents, promotionId,
  // promotionLabel }]. The NAME is captured deliberately: a product deleted
  // between here and the webhook must not take the record of what somebody
  // bought with it.
  lines Json

  // The priced totals, frozen alongside the lines they came from.
  listSubtotalInCents Int
  discountInCents     Int @default(0)
  shippingInCents     Int @default(0)
  totalInCents        Int

  // Which promotion, when exactly one accounts for the whole discount. Null
  // both when nothing was discounted and when several sales covered different
  // lines — the per-line detail inside `lines` carries those.
  appliedPromotionId    String?
  appliedPromotionLabel String?
  appliedPromotionCode  String?
  appliedPromotionKind  PromotionKind?

  // The delivery details, when this checkout went through the shipping step.
  // Personal data belonging to somebody who may never buy, which is why
  // expiresAt exists and why an unconverted draft is purged.
  shippingAddress         Json?
  selectedShippingCarrier String?
  selectedShippingService String?
  selectedShippingRateId  String?

  // Which rail, and the session it became. Written when the customer is
  // redirected; never edited afterwards.
  paymentProvider   IntegrationProvider?
  externalSessionId String?

  // The order this became, once it did.
  orderId String?

  // 48 hours — comfortably past Stripe's 24-hour session and PayPal's ~3-hour
  // order, so a draft never expires under a customer who is still deciding.
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId, status])
  // Finding the draft from what the provider sends back.
  @@index([externalSessionId])
  // The purge reads this: only OPEN drafts that never reached payment.
  @@index([status, expiresAt])
}

enum CheckoutDraftStatus {
  // Created, not yet handed to a provider.
  OPEN
  // The provider session exists and the customer was redirected. From here the
  // row is evidence: a draft that never converts is the only trace that
  // somebody tried to buy something.
  PAYMENT_STARTED
  // It became an order.
  CONVERTED
  // Cancelled, or expired without converting. Kept, never deleted, whenever it
  // reached PAYMENT_STARTED.
  ABANDONED
}

// WHERE AN ORDER'S LINE ITEMS CAME FROM (2026-08-26).
//
// Load-bearing rather than documentary. Profitability computes margin as
// revenue minus product cost and reads cost from the items — so an order with a
// real amount and NO items reads as pure margin, and a handful of them would
// quietly make a business look more profitable than it is in the one report an
// owner uses to decide what to sell. This is what lets those orders be excluded
// from product analytics while still counting as revenue.
enum OrderLineItemSource {
  // The normal path: the frozen draft.
  DRAFT
  // The draft was gone; the provider's own line items were used instead. A
  // complete record, arguably better sourced — it is what the customer was
  // actually charged for.
  PROVIDER
  // Neither was available. The financial record is preserved and NOTHING is
  // invented: the order carries its settled amount and no items at all.
  NONE
}

// ONE PRODUCT ON ONE ORDER (2026-08-26).
//
// ADDITIVE. Order.productId, productName and quantity are untouched and still
// describe the primary line — 154 call sites read them, including profitability,
// customers and the briefing, and none of them is migrated here. For every
// order that existed before bags, and every single-product order after, the two
// agree exactly.
model OrderItem {
  id      String @id @default(cuid())
  orderId String

  // Null when the product has since been deleted. The name below is what keeps
  // the record readable — see productName.
  productId   String?
  // CAPTURED AT PURCHASE, never read back through the relation. A merchant
  // renaming a product does not rewrite what somebody bought.
  productName String

  quantity         Int
  unitPriceInCents Int
  /// unit x quantity, before anything was taken off.
  listInCents      Int
  /// This line's share of the order's discount. Zero when nothing applied.
  discountInCents  Int @default(0)
  /// listInCents - discountInCents.
  subtotalInCents  Int

  // Which promotion discounted THIS line, frozen the same way the order's is.
  // Present for a line's own sale and for a line's share of an order-wide code.
  promotionId    String?
  promotionLabel String?

  createdAt DateTime @default(now())

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([productId])
}
